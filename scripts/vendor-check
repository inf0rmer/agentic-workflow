#!/usr/bin/env python3
"""Report drift between the pinned skill copies in core/skills and an upstream ref.

  scripts/vendor-check [--source <name>] [--upstream <path|url>] [--ref <ref>] [--skills-dir <dir>]

Reads core/skills/UPSTREAM.json (the named upstream sources with their pins and licenses,
and for each skill its source, upstream path and patch), the copies, the stored patches and
the upstream repos, and changes none of them: moving a pin stays a person's decision. Every
source is cloned and checked; --source limits the run to one. --upstream and --ref apply to
a single source, so they need --source when the record holds more than one. One line per
skill, in sorted order:

  <dir>: upstream removed                     the path is gone at the ref
  <dir>: local drift                          the copy differs from upstream at the pin plus its patch
  <dir>: upstream changed[, patch conflict]   the path differs between the pin and the ref
  <dir>: ok
  LICENSE <source>: upstream removed          the upstream LICENSE is gone at the ref (also drift)
  LICENSE <source>: upstream changed          the upstream LICENSE differs between the pin and the ref (also drift)

Exit 0 and "no drift" when every skill is ok, 1 and "drift in <n> skill(s)" otherwise, and 2
with a message on stderr (nothing on stdout) when it cannot run. A URL upstream is cloned
into a temp dir that is removed afterwards; that is the only network use.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
RECORD_KEYS = {"sources", "skills"}
SOURCE_KEYS = {"url", "sha", "date", "license"}
STATUSES = ("as-is", "patched")


class Cannot(Exception):
    pass


class BrokenPatch(Cannot):
    pass


def git(repo, *args, check=True, inp=None):
    p = subprocess.run(["git", "-C", repo, *args], capture_output=True, input=inp)
    if check and p.returncode != 0:
        raise Cannot(f"git {' '.join(args[:2])} failed: {p.stderr.decode(errors='replace').strip()}")
    return p


def load_record(skills_dir):
    path = os.path.join(skills_dir, "UPSTREAM.json")
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except OSError as e:
        raise Cannot(f"can't read {path}: {e.strerror}")
    except ValueError as e:
        raise Cannot(f"{path} is not valid JSON: {e}")
    if not isinstance(data, dict) or set(data) != RECORD_KEYS:
        raise Cannot(f"{path} must have exactly the keys {', '.join(sorted(RECORD_KEYS))}")
    sources = data["sources"]
    if not isinstance(sources, dict) or not sources:
        raise Cannot(f"{path}: sources must be a non-empty object")
    for sname, src in sources.items():
        if not isinstance(src, dict) or set(src) != SOURCE_KEYS:
            raise Cannot(f"{path}: source {sname!r} must have exactly the keys {', '.join(sorted(SOURCE_KEYS))}")
        if not isinstance(src["url"], str) or not src["url"] or not isinstance(src["license"], str) or not src["license"]:
            raise Cannot(f"{path}: source {sname!r} needs a url and a license")
        if not isinstance(src["sha"], str) or not re.fullmatch(r"[0-9a-f]{40}", src["sha"]):
            raise Cannot(f"{path}: source {sname!r}: sha must be 40 lowercase hex digits")
        if not isinstance(src["date"], str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", src["date"]):
            raise Cannot(f"{path}: source {sname!r}: date must be YYYY-MM-DD")
    skills = data["skills"]
    if not isinstance(skills, dict) or not skills:
        raise Cannot(f"{path}: skills must be a non-empty object")
    for name, e in skills.items():
        if not isinstance(e, dict) or e.get("status") not in STATUSES or not isinstance(e.get("upstream_path"), str):
            raise Cannot(f"{path}: skill {name!r} needs an upstream_path and a status of as-is or patched")
        if e.get("source") not in sources:
            raise Cannot(f"{path}: skill {name!r} names an unknown source {e.get('source')!r}")
        want = {"source", "upstream_path", "status"} | ({"patch"} if e["status"] == "patched" else set())
        if set(e) != want:
            raise Cannot(f"{path}: skill {name!r} must have exactly the keys {', '.join(sorted(want))}")
        if e["status"] == "patched":
            if e["patch"] != f"patches/{name}.patch" or not os.path.isfile(os.path.join(skills_dir, e["patch"])):
                raise Cannot(f"{path}: skill {name!r} names a missing or misplaced patch")
    return data


def tree_files(repo, sha, path):
    out = git(repo, "ls-tree", "-r", "--name-only", "-z", sha, "--", path).stdout.decode()
    return sorted(n[len(path) + 1:] for n in out.split("\0") if n)


def blob(repo, sha, path):
    return git(repo, "show", f"{sha}:{path}").stdout


def write_upstream(repo, sha, path, dest):
    for f in tree_files(repo, sha, path):
        target = os.path.join(dest, path, f)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as fh:
            fh.write(blob(repo, sha, f"{path}/{f}"))


def provenance(name, e, src):
    tail = "copied as-is" if e["status"] == "as-is" else f"modified by agentic-workflow (core/skills/patches/{name}.patch)"
    return f"<!-- vendored from {src['url']} {e['upstream_path']} at {src['sha']}; license: {src['license']} (see LICENSE); {tail} -->"


def insert_note(text, note):
    lines = text.split("\n")
    if lines and lines[0] == "---":
        for i in range(1, len(lines)):
            if lines[i] == "---":
                return "\n".join(lines[:i + 1] + [note] + lines[i + 1:])
    return "\n".join([note] + lines)


def files_under(d):
    out = {}
    for dirpath, dirs, files in os.walk(d):
        dirs[:] = [x for x in dirs if x != "__pycache__"]
        for n in files:
            if n.endswith(".pyc"):
                continue
            full = os.path.join(dirpath, n)
            out[os.path.relpath(full, d).replace(os.sep, "/")] = full
    return out


def expected_copy(repo, src, name, e, skills_dir, tmp):
    """Directory holding what the copy should be at the pin: upstream (plus its patch), the note and LICENSE."""
    sha = src["sha"]
    work = tempfile.mkdtemp(dir=tmp)
    write_upstream(repo, sha, e["upstream_path"], work)
    if e["status"] == "patched":
        patch = os.path.abspath(os.path.join(skills_dir, e["patch"]))
        p = subprocess.run(["git", "apply", patch], cwd=work, capture_output=True)
        if p.returncode != 0:
            raise BrokenPatch(f"{e['patch']} does not apply at the pin: {p.stderr.decode(errors='replace').strip()}")
        out = os.path.join(work, "core", "skills", name)
    else:
        out = os.path.join(work, e["upstream_path"])
    skill = os.path.join(out, "SKILL.md")
    if os.path.isfile(skill):
        with open(skill, encoding="utf-8") as f:
            text = f.read()
        with open(skill, "w", encoding="utf-8") as f:
            f.write(insert_note(text, provenance(name, e, src)))
    with open(os.path.join(out, "LICENSE"), "wb") as f:
        f.write(blob(repo, sha, "LICENSE"))
    return out


def local_drift(expected, actual):
    want, have = files_under(expected), files_under(actual)
    lines = []
    for f in sorted(set(want) | set(have)):
        if f not in have:
            lines.append(f"  missing: {f}")
        elif f not in want:
            lines.append(f"  extra: {f}")
        else:
            with open(want[f], "rb") as a, open(have[f], "rb") as b:
                if a.read() != b.read():
                    lines.append(f"  differs: {f}")
    return lines


def upstream_changes(repo, old, new, path):
    out = git(repo, "diff", "-M", "--name-status", "-z", old, new, "--", path).stdout.decode().split("\0")
    lines, i, cut = [], 0, len(path) + 1
    while i < len(out) and out[i]:
        status = out[i]
        if status.startswith("R"):
            lines.append(f"  renamed: {out[i + 1][cut:]} -> {out[i + 2][cut:]}")
            i += 3
            continue
        name = out[i + 1][cut:]
        lines.append({"A": f"  added: {name}", "D": f"  deleted: {name}"}.get(status[0], f"  changed: {name}"))
        i += 2
    return lines


def patch_conflicts(repo, ref, e, skills_dir, tmp):
    work = tempfile.mkdtemp(dir=tmp)
    write_upstream(repo, ref, e["upstream_path"], work)
    patch = os.path.abspath(os.path.join(skills_dir, e["patch"]))
    return subprocess.run(["git", "apply", "--check", patch], cwd=work, capture_output=True).returncode != 0


def open_upstream(location, tmp, label):
    """A local git repo for an upstream location: a path is used as is, a URL is cloned into tmp."""
    repo = location
    if re.match(r"^[a-z][a-z0-9+.-]*://|^git@", location):
        repo = os.path.join(tmp, "upstream-" + label)
        p = subprocess.run(["git", "clone", "-q", location, repo], capture_output=True)
        if p.returncode != 0:
            raise Cannot(f"can't clone {location}: {p.stderr.decode(errors='replace').strip()}")
    elif not os.path.isdir(location):
        raise Cannot(f"can't read upstream {location}: not a directory")
    if git(repo, "rev-parse", "--git-dir", check=False).returncode != 0:
        raise Cannot(f"{location} is not a git repository")
    return repo


def check_source(sname, src, location, ref, record, skills_dir, tmp):
    """(report entries as (sort key, text), drift count, broken patch messages) for one source."""
    repo = open_upstream(location, tmp, sname)
    ref = ref or "HEAD"
    r = git(repo, "rev-parse", "--verify", "--quiet", ref + "^{commit}", check=False)
    if r.returncode != 0:
        raise Cannot(f"the ref {ref!r} is not in the upstream")
    ref = r.stdout.decode().strip()
    pin = src["sha"]
    if git(repo, "cat-file", "-e", pin + "^{commit}", check=False).returncode != 0:
        raise Cannot(f"the pinned commit {pin} is not in the upstream")
    report, drift, broken = [], 0, []
    for name in sorted(n for n, e in record["skills"].items() if e["source"] == sname):
        e = record["skills"][name]
        path = e["upstream_path"]
        if not tree_files(repo, ref, path):
            report.append((name, f"{name}: upstream removed"))
            drift += 1
            continue
        try:
            expected = expected_copy(repo, src, name, e, skills_dir, tmp)
        except BrokenPatch as err:
            report.append((name, f"{name}: patch broken at pin"))
            broken.append(str(err))
            drift += 1
            continue
        actual = os.path.join(skills_dir, name)
        drifted = local_drift(expected, actual) if os.path.isdir(actual) else ["  missing: SKILL.md"]
        if drifted:
            report.append((name, "\n".join([f"{name}: local drift"] + drifted)))
            drift += 1
            continue
        changes = upstream_changes(repo, pin, ref, path)
        if changes:
            conflict = e["status"] == "patched" and patch_conflicts(repo, ref, e, skills_dir, tmp)
            report.append((name, "\n".join([f"{name}: upstream changed" + (", patch conflict" if conflict else "")] + changes)))
            drift += 1
            continue
        report.append((name, f"{name}: ok"))
    if git(repo, "cat-file", "-e", f"{ref}:LICENSE", check=False).returncode != 0:
        report.append(("\uffff" + sname, f"LICENSE {sname}: upstream removed"))
        drift += 1
    elif blob(repo, pin, "LICENSE") != blob(repo, ref, "LICENSE"):
        report.append(("\uffff" + sname, f"LICENSE {sname}: upstream changed"))
        drift += 1
    return report, drift, broken


def run(args):
    skills_dir = os.path.abspath(args.skills_dir)
    record = load_record(skills_dir)
    sources = record["sources"]
    if args.source is not None and args.source not in sources:
        raise Cannot(f"unknown source {args.source!r}; the record has {', '.join(sorted(sources))}")
    chosen = [args.source] if args.source else sorted(sources)
    if (args.upstream or args.ref) and len(chosen) > 1:
        raise Cannot("--upstream and --ref need --source when the record holds more than one source")
    tmp = tempfile.mkdtemp(prefix="vendor-check-", dir=tempfile.gettempdir())
    try:
        report, drift, broken = [], 0, []
        for sname in chosen:
            r, d, b = check_source(sname, sources[sname], args.upstream or sources[sname]["url"], args.ref,
                                   record, skills_dir, tmp)
            report += r
            drift += d
            broken += b
        lines = [text for _, text in sorted(report, key=lambda x: x[0])]
        if broken:
            sys.stdout.write("\n".join(lines) + "\n")
            raise Cannot("; ".join(broken))
        lines.append("no drift" if not drift else f"drift in {drift} skill(s)")
        sys.stdout.write("\n".join(lines) + "\n")
        return 1 if drift else 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--source")
    p.add_argument("--upstream")
    p.add_argument("--ref")
    p.add_argument("--skills-dir", default=os.path.join(os.path.dirname(HERE), "core", "skills"))
    a = p.parse_args()
    try:
        return run(a)
    except Cannot as e:
        print(f"vendor-check: {e}", file=sys.stderr)
        return 2
    except Exception as e:  # never a traceback, and never an exit code a script reads as drift
        print(f"vendor-check: {type(e).__name__}: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
