#!/usr/bin/env python3
"""Ask Jev (typesafe/jev-1.13 via OpenRouter) to make a structured decision.

Reads a decision JSON (file argument or stdin):
  {
    "decision":    "Where should formatDuration() live?",          # required
    "options":     {"colocated": "Keep it next to its caller", ...},  # required, 2+ keys
    "context":     "Short summary of the situation",                # optional
    "constraints": "Hard constraints and costs of change",          # optional
    "caller":      "software-engineer"                              # optional, for the log
  }

Never include PII, customer or tenant data, or secrets; a local check refuses
requests that look like they contain any, and no request is sent.

Prints a JSON verdict:
  ACT       every check is clearly safe and one option clearly wins; take it.
  ESCALATE  in between; send to the researcher/architect/human with Jev's lean.
  DEFER     a risk is clearly present; a human or the researcher decides from
            scratch, Jev's lean is withheld, and PROVISIONAL is not allowed.
Any API or input failure yields ESCALATE so callers fail closed.
"""
import argparse
import datetime
import json
import os
import subprocess
import sys
import urllib.error

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import jevlib  # noqa: E402

# Starting thresholds; tune them from the decision log rather than guessing.
# The choice gate uses the top option's probability: Jev's "confidence" measures how
# concentrated the distribution is, so a clear 0.82/0.18 split only scores ~0.65 there.
MIN_CHOICE_PROBABILITY = float(os.environ.get("JEV_MIN_CHOICE_PROBABILITY", "0.75"))
# A close call on a decision that is free to undo doesn't need a researcher: either option is fine.
TRIVIAL_REVERSIBILITY = float(os.environ.get("JEV_TRIVIAL_REVERSIBILITY", "0.2"))
MIN_CHOICE_PROBABILITY_TRIVIAL = float(os.environ.get("JEV_MIN_CHOICE_PROBABILITY_TRIVIAL", "0.6"))
# Risk propositions use two bands far apart so only the unclear middle is escalated.
RISK_CLEAR_BELOW = float(os.environ.get("JEV_RISK_CLEAR_BELOW", "0.2"))
RISK_PRESENT_AT = float(os.environ.get("JEV_RISK_PRESENT_AT", "0.9"))
MIN_OPTIONS_CLEAR = float(os.environ.get("JEV_MIN_OPTIONS_CLEAR", "0.5"))
MAX_REVERSIBILITY = float(os.environ.get("JEV_MAX_REVERSIBILITY", "0.5"))
DEFER_REVERSIBILITY = float(os.environ.get("JEV_DEFER_REVERSIBILITY", "1.5"))
MIN_REVERSIBILITY_CONFIDENCE = float(os.environ.get("JEV_MIN_REVERSIBILITY_CONFIDENCE", "0.6"))

# Jev has a 32K context; the cap also forces callers to send summaries, not code.
MAX_STATE_CHARS = 6000

REVERSIBILITY_SCALE = [
    "Trivial local refactor",
    "Coordinated change across teams or components",
    "Public API, persisted data, or migration",
]

# Each proposition is true or false of the state on its own, so every escalation
# carries a named reason. "true" means the risk is present.
RISKS = {
    "public_contract": "The decision changes a public API, published package, schema, config format, "
    "or other contract that consumers outside this change depend on.",
    "persisted_data": "The decision changes how data is stored, migrated, or read back from persistent storage.",
    "security_relevant": "The decision affects authentication, authorization, secrets, input validation, "
    "or another security property.",
    "cross_team": "The decision needs agreement from other teams, or touches services that deploy independently.",
}


def noul(instructions, true, false):
    return {"type": "noul", "instructions": instructions, "criteria": {"true": true, "false": false}}


def build_questions(d):
    q = {
        "choice": {
            "type": "choice",
            "instructions": f"Which option is the best answer to: {d['decision']}",
            "criteria": d["options"],
        },
        "options_clear": noul(
            "Are the decision and options specified well enough in the state to choose between them?",
            "The options in the state are distinct and the context is enough to compare them.",
            "The options overlap, key facts are missing, or the right answer depends on information not given.",
        ),
        "reversibility": {
            "type": "score",
            "instructions": "How costly would it be to reverse this decision later?",
            "criteria": REVERSIBILITY_SCALE,
        },
    }
    for name, statement in RISKS.items():
        q[name] = noul(f"Is this true of the decision? {statement}", statement, "This is not true of the decision.")
    return q


def evaluate(a):
    c, rv = a["choice"], a["reversibility"]
    top = c["probabilities"][c["choice"]]
    risks = {name: a[name]["noul"] for name in RISKS}
    clear = a["options_clear"]["noul"]

    defer = [f"{n} {p} ≥ {RISK_PRESENT_AT}" for n, p in risks.items() if p >= RISK_PRESENT_AT]
    if rv["score"] >= DEFER_REVERSIBILITY and rv["confidence"] >= MIN_REVERSIBILITY_CONFIDENCE:
        defer.append(f"reversibility {rv['score']} ≥ {DEFER_REVERSIBILITY}")

    unclear = [f"{n} {p} not < {RISK_CLEAR_BELOW}" for n, p in risks.items() if RISK_CLEAR_BELOW <= p < RISK_PRESENT_AT]
    trivial = rv["score"] <= TRIVIAL_REVERSIBILITY and rv["confidence"] >= MIN_REVERSIBILITY_CONFIDENCE
    min_top = MIN_CHOICE_PROBABILITY_TRIVIAL if trivial else MIN_CHOICE_PROBABILITY
    if top < min_top:
        unclear.append(f"choice probability {top} < {min_top}")
    if clear < MIN_OPTIONS_CLEAR:
        unclear.append(f"options_clear {clear} < {MIN_OPTIONS_CLEAR}")
    if rv["score"] > MAX_REVERSIBILITY:
        unclear.append(f"reversibility {rv['score']} > {MAX_REVERSIBILITY}")
    if rv["confidence"] < MIN_REVERSIBILITY_CONFIDENCE:
        unclear.append(f"reversibility confidence {rv['confidence']} < {MIN_REVERSIBILITY_CONFIDENCE}")

    verdict = "DEFER" if defer else "ESCALATE" if unclear else "ACT"
    result = {
        "verdict": verdict,
        "reasons": defer or unclear,
        "risks": risks,
        "options_clear": clear,
        "reversibility": rv["score"],
        "reversibility_confidence": rv["confidence"],
    }
    # A DEFER goes to someone deciding from scratch; withholding the lean avoids anchoring them.
    if verdict != "DEFER":
        result.update(choice=c["choice"], probabilities=c["probabilities"])
    return result


def default_log_path():
    # Inside the git dir: per-worktree, readable by the whole team, never committed.
    try:
        git_dir = subprocess.run(
            ["git", "rev-parse", "--absolute-git-dir"], check=True, capture_output=True, text=True
        ).stdout.strip()
        return os.path.join(git_dir, "jev-decisions.md")
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def append_log(path, d, result):
    ts = datetime.datetime.now().isoformat(timespec="seconds")
    lines = [
        f"## {ts} — {d.get('decision', '?')}",
        f"- caller: {d.get('caller', 'unknown')}",
        f"- verdict: **{result['verdict']}**" + (f" → `{result['choice']}`" if result.get("choice") else ""),
    ]
    if result.get("probabilities"):
        lines.append("- probabilities: " + ", ".join(f"{k} {v}" for k, v in result["probabilities"].items()))
    if result.get("risks"):
        lines.append("- risks: " + ", ".join(f"{k} {v}" for k, v in result["risks"].items()))
        lines.append(
            f"- options_clear: {result['options_clear']}, reversibility: {result['reversibility']} "
            f"(confidence {result['reversibility_confidence']})"
        )
    if result.get("reasons"):
        lines.append(f"- reasons: {'; '.join(result['reasons'])}")
    if result.get("error"):
        lines.append(f"- error: {result['error']}")
    if result.get("id"):
        lines.append(f"- id: {result['id']}")
    with open(path, "a") as f:
        f.write("\n".join(lines) + "\n\n")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("file", nargs="?", help="decision JSON file (default: stdin)")
    p.add_argument("--log", help="decision log path (default: <git-dir>/jev-decisions.md)")
    p.add_argument("--no-log", action="store_true")
    p.add_argument("--print-log-path", action="store_true", help="print the resolved log path and exit")
    p.add_argument("--raw", action="store_true", help="also print Jev's raw answers")
    args = p.parse_args()
    if args.print_log_path:
        print("ask-jev: not implemented: --print-log-path", file=sys.stderr)
        sys.exit(70)

    d = {}
    try:
        d = json.load(open(args.file) if args.file else sys.stdin)
        if not d.get("decision") or not isinstance(d.get("options"), dict) or len(d["options"]) < 2:
            raise ValueError("need 'decision' and an 'options' object with at least 2 entries")
        # Options go in the state too: Jev judges propositions only against the state.
        state = {k: d[k] for k in ("decision", "options", "context", "constraints") if d.get(k)}
        outbound = json.dumps(state)
        found = jevlib.sensitive_findings(outbound)
        if found:
            raise ValueError(f"refusing to send: possible {', '.join(found)}; abstract it away or decide without Jev")
        if len(outbound) > MAX_STATE_CHARS:
            raise ValueError(f"decision is {len(outbound)} chars (max {MAX_STATE_CHARS}); summarize, don't paste code")

        body = jevlib.decide(state, build_questions(d))
        result = evaluate(body["answers"])
        result.update(id=body.get("id"), model=body.get("model"), cost=body.get("usage", {}).get("cost"))
        if args.raw:
            result["raw"] = body["answers"]
    except urllib.error.HTTPError as e:
        result = {"verdict": "ESCALATE", "error": f"HTTP {e.code}: {e.read().decode()[:300]}"}
    except Exception as e:  # fail closed: any failure means a human or researcher decides
        result = {"verdict": "ESCALATE", "error": f"{type(e).__name__}: {e}"}

    log = None if args.no_log else (args.log or default_log_path())
    if log:
        append_log(log, d, result)
        result["log"] = log
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
