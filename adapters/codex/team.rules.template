# Installed by agentic-workflow. team-guard writes the workspace dirs and signs commits, so it needs to run outside the sandbox.
prefix_rule(pattern=["@HOME@/.codex/team/bin/team-guard"], decision="allow", justification="agentic-workflow workspaces and signing")
prefix_rule(pattern=["~/.codex/team/bin/team-guard"], decision="allow", justification="agentic-workflow workspaces and signing")
