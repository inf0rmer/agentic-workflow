#!/usr/bin/env python3
"""Mutation-test only the code changed on this branch, to find what the tests miss.

  mutation-check [--base origin/main] [--go-only | --ts-only] [--dry-run]
                 [--min-free-gb N] [--max-concurrency N] [--time-box MIN] [--sample N] [--seed S]

(The last five flags are not implemented yet: giving one exits 70.)

Go: gremlins on each changed package, with survivors filtered to changed lines.
    (gremlins v0.5.1's own --diff mode skips every mutant when given a package path,
    and without one it runs the whole module's tests, which is too slow in a monorepo.)
TypeScript: Stryker with the jest runner, mutating only changed files.
Tools are fetched on demand at pinned versions (go run / npx), nothing is installed.

Prints surviving mutants: each one is a concrete behavior change no test noticed.
Exit code is 0 whether or not mutants survive; the tester decides what to do with them.
"""
import argparse
import os
import re
import shlex
import subprocess
import sys

GREMLINS = "github.com/go-gremlins/gremlins/cmd/gremlins@v0.5.1"
STRYKER = ["-p", "@stryker-mutator/core@10.0.0", "-p", "@stryker-mutator/jest-runner@10.0.0"]
TS_EXT = (".ts", ".tsx")
SKIP_PARTS = ("_test.go", ".test.", ".spec.", "__mocks__", "/testdata/", "_gen.go", ".gen.ts", "zz_generated")


def sh(cmd, dry, cwd=None):
    print("$ " + " ".join(shlex.quote(c) for c in cmd), flush=True)
    if dry:
        return 0
    return subprocess.run(cmd, cwd=cwd).returncode


def changed_files(base):
    merge_base = subprocess.run(["git", "merge-base", base, "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
    out = subprocess.run(
        ["git", "diff", "--name-only", "--diff-filter=AM", merge_base], capture_output=True, text=True, check=True
    ).stdout.split()
    return merge_base, [f for f in out if not any(p in f for p in SKIP_PARTS)]


def go_module_root(path):
    d = os.path.dirname(os.path.abspath(path))
    while d != "/":
        if os.path.exists(os.path.join(d, "go.mod")):
            return d
        d = os.path.dirname(d)
    return None


def changed_lines(merge_base, path):
    """Line numbers added or modified in path since merge_base."""
    diff = subprocess.run(["git", "diff", "-U0", merge_base, "--", path], capture_output=True, text=True).stdout
    lines = set()
    for m in re.finditer(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", diff, re.M):
        start, count = int(m.group(1)), int(m.group(2) or 1)
        lines.update(range(start, start + count))
    return lines


MUTANT = re.compile(r"^\s*(LIVED|NOT COVERED|KILLED|TIMED OUT|NOT VIABLE)\s+(\S+) at (\S+?):(\d+):\d+", re.M)


def run_go(files, merge_base, dry):
    pkgs = {}
    for f in files:
        root = go_module_root(f)
        if root:
            pkgs.setdefault((root, os.path.dirname(f)), []).append(f)
    survivors, totals = [], {}
    for (root, pkg_dir), pkg_files in sorted(pkgs.items()):
        wanted = {f: changed_lines(merge_base, f) for f in pkg_files}
        cmd = ["go", "run", GREMLINS, "unleash", "--timeout-coefficient", "20", "-S", "lcktv",
               "./" + os.path.relpath(os.path.abspath(pkg_dir), root)]
        print("$ " + " ".join(shlex.quote(c) for c in cmd), f"(in {os.path.relpath(root) or '.'})", flush=True)
        if dry:
            continue
        out = subprocess.run(cmd, cwd=root, capture_output=True, text=True)
        if out.returncode and not MUTANT.search(out.stdout):
            print(out.stdout[-2000:] + out.stderr[-2000:], file=sys.stderr)
            continue
        for status, mutator, name, line in MUTANT.findall(out.stdout):
            f = os.path.join(pkg_dir, name)
            if int(line) not in wanted.get(f, ()):
                continue  # mutant on code this branch didn't touch
            totals[status] = totals.get(status, 0) + 1
            if status in ("LIVED", "NOT COVERED"):
                survivors.append(f"{status:11} {mutator:28} {f}:{line}")
    if dry:
        return
    print("\nGo mutants on changed lines: " + (", ".join(f"{k.lower()} {v}" for k, v in sorted(totals.items())) or "none"))
    killed, lived = totals.get("KILLED", 0), totals.get("LIVED", 0) + totals.get("NOT COVERED", 0)
    if killed + lived:
        print(f"mutation score: {killed / (killed + lived):.0%} (killed / (killed + lived + not covered))")
    if survivors:
        print("\nSurvivors — each is a behavior change no test noticed:\n  " + "\n  ".join(survivors))


def run_ts(files, dry):
    if not files:
        return
    sh(["npx", "--yes", *STRYKER, "stryker", "run", "--testRunner", "jest", "--coverageAnalysis", "perTest",
        "--reporters", "clear-text,progress", "--mutate", ",".join(files)], dry)


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--base", default="origin/main")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--go-only", action="store_true")
    g.add_argument("--ts-only", action="store_true")
    p.add_argument("--dry-run", action="store_true", help="print the commands without running them")
    for flag, kind in (("--min-free-gb", int), ("--max-concurrency", int), ("--time-box", int),
                       ("--sample", int), ("--seed", int)):
        p.add_argument(flag, type=kind, default=None)
    a = p.parse_args()
    for flag in ("min_free_gb", "max_concurrency", "time_box", "sample", "seed"):
        if getattr(a, flag) is not None:
            print(f"mutation-check: not implemented: --{flag.replace('_', '-')}", file=sys.stderr)
            return 70

    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    os.chdir(top)
    merge_base, files = changed_files(a.base)
    go_files = [f for f in files if f.endswith(".go")]
    ts_files = [f for f in files if f.endswith(TS_EXT)]
    print(f"changed since {merge_base[:12]}: {len(go_files)} Go, {len(ts_files)} TypeScript file(s)")
    if not go_files and not ts_files:
        return
    if not a.ts_only:
        run_go(go_files, merge_base, a.dry_run)
    if not a.go_only:
        run_ts(ts_files, a.dry_run)


if __name__ == "__main__":
    sys.exit(main())
