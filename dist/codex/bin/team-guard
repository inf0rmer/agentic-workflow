#!/usr/bin/env python3
"""Guard rails for the agent-team workflow: locked tests, holdout scenarios and per-feature workspaces.

The tester writes acceptance tests before implementation, commits them, and seals
them. The engineer must make them pass without changing them; any change to a
sealed file is detected by comparing its content hash with the one recorded when
it was sealed (older locks fall back to comparing with the sealed commit).

  team-guard seal <path>...     lock committed test files at HEAD (tester)
  team-guard unseal <path>...   release files for a sanctioned fix (tester; logged)
  team-guard verify             exit 2 and list any sealed file that changed; inside a
                                workspace it checks every attached repo
  team-guard list               show sealed files and the lock history
  team-guard holdout-path       print the holdout-scenario directory (per workspace
                                inside one, else per repo and branch)
  team-guard git-hook install|uninstall|status [pre-commit|pre-push]
                                manage the git hooks that refuse commits and pushes
                                changing sealed tests (sealing installs them)
  team-guard pre-push [<remote> <url>]
                                git pre-push: refuse a push if sealed tests changed

Workspaces (one per feature, under ~/.agentic-workflow/work/<feature>/):
  team-guard workspace new <feature> [--branch <name>]
  team-guard workspace attach <repo-path> [--base <branch>] [--feature <feature>]
  team-guard workspace list [--stale-days <N>]
  team-guard workspace show [<feature>]
  team-guard workspace close <feature> [--force]
  team-guard workspace-path     print the workspace dir containing the cwd
  team-guard gc [--apply] [--stale-days <N>] [--retention-days <R>]
                                list (or with --apply, collect) stale workspaces,
                                orphan holdouts and expired archives

Workflow tooling:
  team-guard refs [--base <ref>] [--config <file>]
  team-guard routing record route [--feature F] --proposed V --confirmed V [--answer k=v]... [--override-reason TEXT]
  team-guard routing record step [--feature F] --step SLUG --seconds N
  team-guard routing record upgrade [--feature F] --to V --reason TEXT
  team-guard routing summary [--json]
  team-guard risk [--base R] [--feature F] [--answer k=v]... [--contract none|additive|breaking|unknown]
                  [--majors-fixed N] [--holdouts-failed N] [--mutation-skipped yes|no|unknown]
                  [--human-level high|medium|low] [--pr-budget N | TEAM_PR_BUDGET] [--packet] [--no-log]
  team-guard sign [--base <ref>]
  team-guard gate review <gate> [<file>...] [--new] [--no-open]
  team-guard gate reply <gate> --file <json> --author <role>
  team-guard gate record <gate> [<file>...] (--crit | --chat \"<reply>\")
  team-guard gate check [<gate>]

Hook entry points (read the hook event JSON on stdin):
  team-guard hook-pretool       PreToolUse: deny edits to sealed files and holdout
                                reads when the agent is identifiable as non-tester
  team-guard hook-task          TaskCompleted (Claude Code): block completion if verify fails
  team-guard hook-stop          SubagentStop (Claude Code and Codex): send the subagent back if verify fails
  team-guard pre-commit         git pre-commit: refuse staged changes to sealed files

Environment: TEAM_PR_BUDGET, TEAM_LOG_ROOT, TEAM_REFS_CONFIG, TEAM_WORKSPACE_ROOT, TEAM_HOLDOUT_ROOT, TEAM_ARCHIVE_ROOT,
TEAM_STALE_DAYS, TEAM_ARCHIVE_RETENTION_DAYS.

The git hooks work with any agent harness, or none: a sealed test has to be
unsealed (which is logged for the reviewer) before a commit can change it.
"""
import argparse
import calendar
import datetime
import fcntl
import hashlib
import json
import os
import re
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import time

LOCK_NAME = "team-test-lock.json"
POINTER_NAME = "team-workspace"
WS_FILE = "workspace.json"
HOLDOUT_MARKER = ".workspace"
# Agents allowed to edit sealed tests. Everyone else is denied when the hook can tell who they are.
TEST_OWNERS = {"tester"}
# Agents that must never read holdout scenarios.
HOLDOUT_BLIND = {"software-engineer"}
INNER_LOOP_SKILL = "tdd-inner-loop"
EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit", "apply_patch"}
HOOK_MARKER = "# managed by team-guard"
CHAINED_SUFFIX = ".team-guard-chained"
READ_TOOLS = {"Read", "Grep", "Glob"}
HOOK_NAMES = ("pre-commit", "pre-push")
FEATURE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
TS_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
DAY = 86400


# --- roots and small helpers ------------------------------------------------

def _root(var, default):
    return os.path.expanduser(os.environ.get(var) or default)


def ws_root():
    return os.path.realpath(_root("TEAM_WORKSPACE_ROOT", "~/.agentic-workflow/work"))


def holdout_root(real=True):
    root = _root("TEAM_HOLDOUT_ROOT", "~/.agentic-workflow/holdout")
    return os.path.realpath(root) if real else root


def archive_root():
    return os.path.realpath(_root("TEAM_ARCHIVE_ROOT", "~/.agentic-workflow/archive"))


def die(msg, code=1):
    print(f"team-guard: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"team-guard: warning: {msg}", file=sys.stderr)


def git(*args, cwd=None, check=True):
    return subprocess.run(["git", *args], cwd=cwd, check=check, capture_output=True, text=True, stdin=subprocess.DEVNULL)


def realpath(p):
    return os.path.realpath(p)


def under(path, root):
    path, root = realpath(path), realpath(root)
    if path == root:
        return True
    try:
        return os.path.commonpath([path, root]) == root
    except ValueError:
        return False


def nearest_existing_dir(p):
    p = os.path.abspath(p)
    while not os.path.exists(p):
        parent = os.path.dirname(p)
        if parent == p:
            break
        p = parent
    return p if os.path.isdir(p) else os.path.dirname(p)


def utc_now():
    return time.strftime(TS_FORMAT, time.gmtime())


def parse_ts(s):
    try:
        return calendar.timegm(time.strptime(s, TS_FORMAT))
    except (TypeError, ValueError):
        return None


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def int_setting(value, env_var, default, option):
    """A command-line option beats its env var, which beats the default; all must be non-negative ints."""
    if value is not None:
        name, raw = option, value
    elif os.environ.get(env_var) not in (None, ""):
        name, raw = env_var, os.environ[env_var]
    else:
        return default
    try:
        n = int(str(raw).strip())
    except ValueError:
        die(f"invalid {name}: {raw!r} is not a non-negative integer")
    if n < 0:
        die(f"invalid {name}: {raw!r} is not a non-negative integer")
    return n


# --- locating repos and workspaces ------------------------------------------

def repo_ids(d):
    """(top, absolute git dir, absolute common git dir) for the repo containing directory d, or None."""
    r = git("rev-parse", "--show-toplevel", "--absolute-git-dir", "--git-common-dir", cwd=d, check=False)
    lines = r.stdout.split("\n")
    if r.returncode or len(lines) < 3:
        return None
    top, gd, common = lines[:3]
    return realpath(top), realpath(gd), realpath(os.path.join(d, common))


def read_first_line(path):
    try:
        with open(path) as f:
            return f.readline().strip() or None
    except OSError:
        return None


def location_workspace(p):
    """The workspace dir that path p is in by location, or None."""
    root = ws_root()
    p = realpath(p)
    if p == root or not under(p, root):
        return None
    feature = os.path.relpath(p, root).split(os.sep)[0]
    if feature.startswith(".") or not os.path.isdir(os.path.join(root, feature)):
        return None
    return os.path.join(root, feature)


def resolve_workspace(start):
    """("ok", dir) | ("dangling", pointer) | None for a cwd or target path."""
    d = nearest_existing_dir(start)
    ids = repo_ids(d)
    if ids and ids[1] != ids[2]:  # a linked worktree
        ptr = read_first_line(os.path.join(ids[1], POINTER_NAME))
        if ptr:
            return ("ok", ptr) if os.path.isfile(os.path.join(ptr, WS_FILE)) else ("dangling", ptr)
    loc = location_workspace(d)
    return ("ok", loc) if loc else None


def repo_for_path(p):
    """(top, git dir) of the repo containing path p, or None. Never reads workspace.json."""
    d = nearest_existing_dir(p)
    ids = repo_ids(d)
    if not ids:
        return None
    loc = location_workspace(d)
    if loc and not under(ids[0], loc):
        return None  # the workspace root happens to sit inside some other repo
    return ids[0], ids[1]


class WorkspaceFileError(Exception):
    def __init__(self, path):
        super().__init__(path)
        self.path = path


def load_workspace(wsdir):
    path = os.path.join(wsdir, WS_FILE)
    try:
        with open(path) as f:
            data = json.load(f)
        if not isinstance(data, dict) or not isinstance(data.get("repos"), list):
            raise ValueError("not a workspace")
    except (OSError, ValueError):
        raise WorkspaceFileError(path)
    return data


def workspace_file_die(e, code=1):
    die(f"can't read {e.path} (missing or not valid JSON)", code)


def write_json_atomic(path, data):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def save_workspace(wsdir, data):
    names = [r["name"] for r in data["repos"]]
    sources = [r["source"] for r in data["repos"]]
    assert len(set(names)) == len(names) and len(set(sources)) == len(sources), "duplicate repo entry"
    write_json_atomic(os.path.join(wsdir, WS_FILE), data)


NO_WORKSPACE = ("no workspace found; create one with `team-guard workspace new <feature>` "
                "or run this from a workspace dir or an attached worktree")


def current_workspace_or_die():
    """The workspace dir containing the cwd; exits otherwise."""
    ws = resolve_workspace(os.getcwd())
    if ws is None:
        die(NO_WORKSPACE)
    if ws[0] == "dangling":
        die(f"the workspace pointer here is dangling: {ws[1]} has no {WS_FILE}")
    return ws[1]


def named_workspace_or_die(feature):
    if not valid_feature(feature) or not os.path.isdir(os.path.join(ws_root(), feature)):
        die(f"no workspace named {feature}")
    return os.path.join(ws_root(), feature)


def valid_feature(name):
    return bool(name and FEATURE_RE.match(name) and ".." not in name and not name.endswith((".", ".lock")))


def require_repo():
    """(top, git dir) for the cwd, or exit with the message for a workspace dir or a non-repo."""
    r = repo_for_path(os.getcwd())
    if r:
        return r
    ws = resolve_workspace(os.getcwd())
    if ws and ws[0] == "ok":
        try:
            repos = load_workspace(ws[1])["repos"]
        except WorkspaceFileError:
            repos = None
        msg = f"{ws[1]} is a workspace dir, not a repo; cd into an attached worktree:"
        if repos is None:
            msg = f"{ws[1]} is a workspace dir, not a repo; cd into an attached worktree (repos/<name>)"
        elif repos:
            msg += "\n" + "\n".join("  " + r["worktree"] for r in repos)
        else:
            msg += "\n  no repos attached yet"
        die(msg)
    die("not a git repository")


# --- lock -------------------------------------------------------------------

def load_lock(git_dir):
    path = os.path.join(git_dir, LOCK_NAME)
    if not os.path.exists(path):
        return {"files": {}, "history": []}
    with open(path) as f:
        return json.load(f)


def save_lock(git_dir, lock):
    with open(os.path.join(git_dir, LOCK_NAME), "w") as f:
        json.dump(lock, f, indent=2)


def rel(top, path):
    return os.path.relpath(os.path.realpath(os.path.join(os.getcwd(), path)), os.path.realpath(top))


SEAL_USAGE = {"seal": "usage: team-guard seal <path>...     lock committed test files at HEAD",
              "unseal": "usage: team-guard unseal <path>...   release files for a sanctioned fix (logged)"}


def check_seal_args(cmd, paths):
    """Handle --help/-h (usage, exit 0) and refuse any other dash option (exit 1) before anything is written."""
    if any(p in ("-h", "--help") for p in paths):
        print(SEAL_USAGE[cmd])
        sys.exit(0)
    for p in paths:
        if p.startswith("-"):
            die(f"{cmd}: unknown option {p}; to name a file that starts with -, prefix it with ./\n{SEAL_USAGE[cmd]}")


def cmd_seal(paths):
    check_seal_args("seal", paths)
    top, git_dir = require_repo()
    head = git("rev-parse", "HEAD").stdout.strip()
    lock = load_lock(git_dir)
    files = [rel(top, p) for p in paths]
    for f in files:
        if git("ls-files", "--error-unmatch", "--", f, cwd=top, check=False).returncode:
            sys.exit(f"team-guard: {f} is not tracked; commit it before sealing")
        if git("diff", "--quiet", "HEAD", "--", f, cwd=top, check=False).returncode:
            sys.exit(f"team-guard: {f} has uncommitted changes; commit it before sealing")
    blobs = lock.setdefault("blobs", {})
    for f in files:
        lock["files"][f] = head
        blobs[f] = git("rev-parse", f"{head}:{f}", cwd=top).stdout.strip()
    lock["history"].append({"at": now(), "action": "seal", "commit": head, "files": files})
    save_lock(git_dir, lock)
    print(f"sealed {len(files)} file(s) at {head[:12]}")
    install_hooks(only_missing=True)


def cmd_unseal(paths):
    check_seal_args("unseal", paths)
    top, git_dir = require_repo()
    lock = load_lock(git_dir)
    files = [rel(top, p) for p in paths]
    for f in files:
        lock["files"].pop(f, None)
        if "blobs" in lock:
            lock["blobs"].pop(f, None)
    lock["history"].append({"at": now(), "action": "unseal", "files": files})
    save_lock(git_dir, lock)
    print(f"unsealed {len(files)} file(s); reseal after the fix")


def violations_in(top, git_dir):
    """Problems with one repo's sealed files, in lock order: 'file (deleted)' / 'file (changed since c12)'."""
    lock = load_lock(git_dir)
    blobs = lock.get("blobs") or {}
    present = [f for f in lock["files"] if os.path.exists(os.path.join(top, f))]
    hashed = [f for f in present if f in blobs]
    current = {}
    if hashed:
        out = git("hash-object", "--", *hashed, cwd=top, check=False).stdout.split("\n")
        current = dict(zip(hashed, out))
    bad = []
    for f, commit in lock["files"].items():
        if f not in present:
            bad.append(f"{f} (deleted)")
        elif f in blobs:
            if current.get(f) != blobs[f]:
                bad.append(f"{f} (changed since {commit[:12]})")
        elif git("diff", "--quiet", commit, "--", f, cwd=top, check=False).returncode:
            bad.append(f"{f} (changed since {commit[:12]})")
    return bad


class NoRepo(Exception):
    pass


def hooks_path_warning(top, name=None):
    """A warning when core.hooksPath hides team-guard's git hooks from a repo with sealed files, else None."""
    value = git("config", "--get", "core.hooksPath", cwd=top, check=False).stdout.strip()
    if not value or hook_state("pre-commit", top) == "installed":
        return None
    who = "Husky" if ".husky" in value.replace("\\", "/").split("/") else "a tool such as Husky"
    return ((f"{name}: " if name else "") + f"core.hooksPath is {value}; {who} sets this, and git then ignores "
            "team-guard's hooks in .git/hooks, so verify and the reviewer are the remaining checks "
            "(team-guard git-hook install would write into that directory)")


def guard_scope(cwd):
    """What verify, hook-task and hook-stop check from cwd.

    Returns (lines, count, in_workspace, warnings, hook_warnings). Raises NoRepo outside any repo and
    WorkspaceFileError for an unreadable workspace.json."""
    ws = resolve_workspace(cwd)
    warnings = []
    if ws and ws[0] == "ok":
        data = load_workspace(ws[1])
        lines, hook_warnings = [], []
        for e in data["repos"]:
            name, wt = e["name"], e["worktree"]
            if not os.path.isdir(wt):
                lines.append(f"{name}: worktree missing: {wt}")
                continue
            ids = repo_ids(wt)
            if not ids or ids[0] != realpath(wt):
                lines.append(f"{name}: repository unavailable: {wt}")
                continue
            lines.extend(f"{name}: {v}" for v in violations_in(ids[0], ids[1]))
            if load_lock(ids[1])["files"] and hook_state("pre-commit", wt) != "installed":
                hook_warnings.append(f"the pre-commit hook is not installed in {name} (another tool may have "
                                     f"replaced it); run `team-guard git-hook install` there")
            if load_lock(ids[1])["files"] and hooks_path_warning(wt, name):
                hook_warnings.append(hooks_path_warning(wt, name))
        return lines, len(data["repos"]), True, warnings, hook_warnings
    if ws and ws[0] == "dangling":
        warnings.append(f"the workspace pointer here is dangling ({ws[1]}); checking only this repo")
    r = repo_for_path(cwd)
    if not r:
        raise NoRepo
    hook_warnings = []
    if load_lock(r[1])["files"] and hook_state("pre-commit", r[0]) != "installed":
        hook_warnings.append("the pre-commit hook is not installed (another tool may have replaced it); "
                             "run `team-guard git-hook install`")
    if load_lock(r[1])["files"] and hooks_path_warning(r[0]):
        hook_warnings.append(hooks_path_warning(r[0]))
    return violations_in(*r), 1, False, warnings, hook_warnings


def cmd_verify():
    try:
        lines, count, in_ws, warnings, hook_warnings = guard_scope(os.getcwd())
    except NoRepo:
        die("not a git repository")
    except WorkspaceFileError as e:
        workspace_file_die(e, 2)
    for w in warnings:
        warn(w)
    for w in hook_warnings:
        print("team-guard: warning: " + w, file=sys.stderr)
    if lines:
        print("team-guard: sealed tests were modified:\n  " + "\n  ".join(lines), file=sys.stderr)
        sys.exit(2)
    if in_ws:
        print(f"team-guard: all sealed tests unchanged in {count} attached repo(s)")
    else:
        print("team-guard: all sealed tests unchanged")


def cmd_list():
    _, git_dir = require_repo()
    print(json.dumps(load_lock(git_dir), indent=2))


# --- holdouts ---------------------------------------------------------------

def cmd_holdout_path():
    cwd = os.getcwd()
    ws = resolve_workspace(cwd)
    if ws and ws[0] == "dangling":
        die(f"the workspace pointer here is dangling: {ws[1]} has no {WS_FILE}")
    if ws:
        feature = os.path.basename(ws[1])
        path = os.path.join(holdout_root(), feature)
        if under(path, ws[1]):
            die(f"the holdout root {holdout_root()} is inside the workspace dir {ws[1]}; set TEAM_HOLDOUT_ROOT elsewhere")
        marker = os.path.join(path, HOLDOUT_MARKER)
        if os.path.isdir(path) and not os.path.exists(marker) and os.listdir(path):
            die(f"{path} exists without a workspace marker and collides with a holdout directory of that name")
        os.makedirs(path, exist_ok=True)
        if not os.path.exists(marker):
            with open(marker, "w") as f:
                json.dump({"feature": feature, "workspace": ws[1]}, f)
        print(path)
        return
    r = repo_for_path(cwd)
    if not r:
        die("not a git repository")
    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip().replace("/", "-")
    path = os.path.join(holdout_root(real=False), os.path.basename(r[0]), branch)
    os.makedirs(path, exist_ok=True)
    print(path)


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))


PATCH_FILE = re.compile(r"^\*\*\* (?:Add File|Update File|Delete File|Move to): (.+?)\s*$", re.M)


def targets(tool_input):
    """Paths a tool call touches: Claude Code passes one path; Codex's apply_patch passes patch text."""
    for key in ("file_path", "notebook_path", "path"):
        if tool_input.get(key):
            return [tool_input[key]]
    patch = tool_input.get("command") or tool_input.get("input") or ""
    if isinstance(patch, list):
        patch = "\n".join(patch)
    return PATCH_FILE.findall(patch) if "*** Begin Patch" in patch else []


def pattern_paths(tool, tool_input, cwd):
    """Directories a Glob pattern or a Grep glob names before its first wildcard, resolved."""
    key = {"Glob": "pattern", "Grep": "glob"}.get(tool)
    pattern = tool_input.get(key) if key else None
    if not isinstance(pattern, str) or not pattern:
        return []
    base = tool_input.get("path") if isinstance(tool_input.get("path"), str) and tool_input.get("path") else cwd
    cut = min([i for i in (pattern.find(c) for c in "*?[{") if i >= 0] or [len(pattern)])
    prefix = pattern[:cut]
    prefix = prefix[:prefix.rfind("/")] if "/" in prefix else ""
    try:
        return [os.path.realpath(os.path.join(cwd, base, prefix))]
    except (ValueError, OSError):
        return []


def reaches_review_data(paths, reading):
    """True if a resolved path is in some workspace's .crit or reviews dir (reads: or above a workspace dir).

    Names are compared without regard to case, since the usual file systems don't tell them apart."""
    root = ws_root()
    try:
        names = [n for n in os.listdir(root) if os.path.isdir(os.path.join(root, n))]
    except OSError:
        return False

    def inside(p, d):
        return p == d or p.startswith(d.rstrip("/") + "/")

    for d in names:
        wsd = os.path.join(root, d).lower()
        for p in (x.lower() for x in paths):
            if any(inside(p, wsd + "/" + sub) for sub in (".crit", "reviews")):
                return True
            if reading and inside(wsd, p):
                return True
    return False


def cmd_hook_pretool():
    event = json.load(sys.stdin)
    agent = event.get("agent_type")
    if not agent:
        return  # main thread or unidentified teammate: git and verify catch it
    tool = event.get("tool_name")
    if tool == "Skill":
        ti = event.get("tool_input")
        name = ti.get("skill") if isinstance(ti, dict) else None
        if agent in TEST_OWNERS and isinstance(name, str) and name.strip().removeprefix("/").rsplit(":", 1)[-1] == INNER_LOOP_SKILL:
            deny("tdd-inner-loop is the software-engineer's inner loop, not the tester's. Work from the spec and contract.md.")
        return
    paths = targets(event.get("tool_input") or {})
    cwd = event.get("cwd") or os.getcwd()
    extra = pattern_paths(tool, event.get("tool_input") or {}, cwd) if agent in TEST_OWNERS else []
    if not paths and not extra:
        return
    try:
        paths = [os.path.realpath(os.path.join(cwd, p)) for p in paths]
    except (ValueError, OSError, TypeError):
        return  # a path that can't be resolved is never a reason to crash

    if agent in TEST_OWNERS and tool in READ_TOOLS | EDIT_TOOLS and reaches_review_data(paths + extra, tool in READ_TOOLS):
        return deny("Review discussion in the workspace's .crit/ and reviews/ is hidden from the tester by design. "
                    "Work from the spec and contract.md.")

    holdout = holdout_root()
    if agent in HOLDOUT_BLIND and (
            (tool in READ_TOOLS | EDIT_TOOLS and any(under(p, holdout) for p in paths))
            or (tool in READ_TOOLS and any(under(holdout, p) for p in paths))):
        return deny("Holdout scenarios are hidden from the engineer by design. Work from the spec and the sealed tests.")

    if tool not in EDIT_TOOLS or agent in TEST_OWNERS:
        return
    # The repo and its seals come from each target path, never from the event's cwd.
    by_dir, locks, hits = {}, {}, []
    cwd_real = realpath(cwd)
    for p in paths:
        d = nearest_existing_dir(p)
        if d not in by_dir:
            by_dir[d] = repo_for_path(d)
        repo = by_dir[d]
        if not repo:
            continue
        top, git_dir = repo
        if git_dir not in locks:
            locks[git_dir] = load_lock(git_dir)["files"]
        r = os.path.relpath(p, top)
        if r in locks[git_dir]:
            hits.append(r if under(cwd_real, top) else f"{os.path.basename(top)}:{r}")
    if hits:
        deny(f"{', '.join(hits)} {'is' if len(hits) == 1 else 'are'} sealed by the tester. Don't change sealed tests: "
             "if you believe one is wrong, report the failing assertion and why the spec supports your reading.")


def hook_violations(event):
    """Violation lines for a stop or task event, or [] when there is nothing to report."""
    try:
        return guard_scope(event.get("cwd") or os.getcwd())[0]
    except NoRepo:
        return []
    except WorkspaceFileError as e:
        return [f"can't read {e.path} (missing or not valid JSON)"]


def cmd_hook_stop():
    event = json.load(sys.stdin)
    bad = hook_violations(event)
    if not bad:
        return
    msg = "Sealed tests were modified:\n  " + "\n  ".join(bad)
    if event.get("stop_hook_active"):
        # Already sent back once; don't loop. verify and review still catch it.
        print(json.dumps({"systemMessage": "team-guard: " + msg}))
        return
    print(json.dumps({"decision": "block", "reason": msg + "\nRestore them (git checkout <sealed commit> -- <file>) "
                      "before finishing, or report why a sealed test is wrong."}))


def cmd_hook_task():
    event = json.load(sys.stdin)
    bad = hook_violations(event)
    if bad:
        print("Sealed tests were modified, so this task can't complete:\n  " + "\n  ".join(bad)
              + "\nRestore them (git checkout <sealed commit> -- <file>) or ask the tester to review and reseal.",
              file=sys.stderr)
        sys.exit(2)


# --- git hooks --------------------------------------------------------------

def hook_paths(name, cwd=None):
    hooks = git("rev-parse", "--git-path", "hooks", cwd=cwd).stdout.strip()
    hook = os.path.join(os.path.abspath(os.path.join(cwd or ".", hooks)), name)
    return hook, hook + CHAINED_SUFFIX


def hook_state(name="pre-commit", cwd=None):
    hook, _ = hook_paths(name, cwd)
    if not os.path.exists(hook):
        return "missing"
    with open(hook, errors="replace") as f:
        return "installed" if HOOK_MARKER in f.read() else "foreign"


def hook_script(name, guard):
    if name == "pre-push":
        # git feeds the ref list on stdin: keep it for the chained hook, hide it from ours.
        return f"""#!/bin/sh
{HOOK_MARKER}; the previous hook, if any, runs after it from pre-push{CHAINED_SUFFIX}
input=$(cat)
"{guard}" pre-push "$@" </dev/null || exit 1
chained="$(dirname "$0")/pre-push{CHAINED_SUFFIX}"
if [ -x "$chained" ]; then
  if [ -n "$input" ]; then printf '%s\\n' "$input" | "$chained" "$@"; else "$chained" "$@" </dev/null; fi
  exit $?
fi
"""
    return f"""#!/bin/sh
{HOOK_MARKER}; the previous hook, if any, runs after it from {name}{CHAINED_SUFFIX}
"{guard}" {name} || exit 1
chained="$(dirname "$0")/{name}{CHAINED_SUFFIX}"
if [ -x "$chained" ]; then exec "$chained" "$@"; fi
"""


def hooks_dir_in_work_tree():
    """The hooks dir (relative to the work tree) when it lies inside the work tree outside the git dir, else None."""
    top = realpath(git("rev-parse", "--show-toplevel").stdout.strip())
    hooks = realpath(os.path.abspath(git("rev-parse", "--git-path", "hooks").stdout.strip()))
    gitdirs = [realpath(os.path.abspath(git("rev-parse", flag).stdout.strip()))
               for flag in ("--git-dir", "--git-common-dir")]
    if any(hooks == g or hooks.startswith(g + os.sep) for g in gitdirs):
        return None
    if hooks == top or hooks.startswith(top + os.sep):
        return os.path.relpath(hooks, top)
    return None


def install_hooks(only_missing=False):
    """Install the guard hooks, unless the hooks dir is a project directory: then write nothing and warn."""
    inside = hooks_dir_in_work_tree()
    if inside:
        warn(f"core.hooksPath puts the hooks dir inside the work tree ({inside}), which belongs to the project; "
             "the guard hooks aren't installed there. verify and the reviewer are the remaining checks.")
        return
    for name in HOOK_NAMES:
        if not only_missing or hook_state(name) != "installed":
            install_hook(name)


def install_hook(name="pre-commit"):
    hook, chained = hook_paths(name)
    state = hook_state(name)
    if state == "installed":
        print(f"team-guard: {name} hook already installed")
        return
    os.makedirs(os.path.dirname(hook), exist_ok=True)
    if state == "foreign":
        os.replace(hook, chained)  # keep the existing hook (e.g. lefthook) and run it after ours
    guard = os.path.realpath(sys.argv[0])
    with open(hook, "w") as f:
        f.write(hook_script(name, guard))
    os.chmod(hook, os.stat(hook).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(f"team-guard: installed {name} hook" + (" (chaining the existing one)" if state == "foreign" else ""))


def uninstall_hook(name="pre-commit"):
    hook, chained = hook_paths(name)
    if hook_state(name) != "installed":
        print(f"team-guard: {name} hook is not team-guard's; left alone")
        return
    os.remove(hook)
    if os.path.exists(chained):
        os.replace(chained, hook)
    print(f"team-guard: removed {name} hook" + (" and restored the previous one" if os.path.exists(hook) else ""))


def cmd_git_hook(args):
    action = args[0] if args else "status"
    which = args[1] if len(args) > 1 else None
    if action not in ("install", "uninstall", "status") or which not in (None, *HOOK_NAMES):
        sys.exit(__doc__)
    require_repo()
    if action == "install":
        install_hooks()
    elif action == "uninstall":
        for name in HOOK_NAMES:
            uninstall_hook(name)
    else:
        print(hook_state(which or "pre-commit"))


def cmd_pre_commit():
    top, git_dir = require_repo()
    lock = load_lock(git_dir)
    sealed, blobs = lock["files"], lock.get("blobs") or {}
    staged = [f for f in git("diff", "--cached", "--name-only", "--no-renames", "-z", cwd=top).stdout.split("\0") if f]
    staged = [f for f in staged if f in sealed]
    index = {}
    hashed = [f for f in staged if f in blobs]
    if hashed:
        for entry in git("ls-files", "-s", "-z", "--", *hashed, cwd=top).stdout.split("\0"):
            meta, _, path = entry.partition("\t")
            parts = meta.split()
            if path and len(parts) == 3 and parts[2] == "0":
                index[path] = parts[1]
    # A staged change that makes the file match its sealed version again is a restore, not a change.
    hits = sorted(f for f in staged
                  if (index.get(f) != blobs[f] if f in blobs else
                      git("diff", "--cached", "--quiet", sealed[f], "--", f, cwd=top, check=False).returncode))
    if hits:
        print("team-guard: this commit changes sealed tests:\n  " + "\n  ".join(hits)
              + "\nSealed tests define done and can't change in place. If one is wrong, the tester unseals it "
              "(`team-guard unseal <file>`, logged for the reviewer), fixes it, commits, and reseals.",
              file=sys.stderr)
        sys.exit(1)


def cmd_pre_push(args):
    r = repo_for_path(os.getcwd())
    if not r:
        die("not in a git repository")
    bad = violations_in(*r)
    if bad:
        print("team-guard: push refused: sealed tests were modified:\n  " + "\n  ".join(bad), file=sys.stderr)
        sys.exit(1)


# --- argument parsing -------------------------------------------------------

class UsageError(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise UsageError(message)


def parse_or_exit(parser, args):
    try:
        return parser.parse_args(args)
    except UsageError as e:
        print(f"team-guard: {parser.prog}: {e}", file=sys.stderr)
        sys.exit(1)


# --- workspace status -------------------------------------------------------

def repo_ok(path):
    return os.path.isdir(path) and git("rev-parse", "--git-dir", cwd=path, check=False).returncode == 0


def rev_parse(repo, ref):
    r = git("rev-parse", "--verify", "-q", ref, cwd=repo, check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def base_refs(source, base):
    refs = ["refs/heads/" + base]
    out = git("for-each-ref", "--format=%(refname)", "refs/remotes", cwd=source, check=False).stdout.split()
    refs += [r for r in out if r.endswith("/" + base) and not r.endswith("/HEAD")]
    return refs


def entry_merged(e):
    tip = rev_parse(e["source"], "refs/heads/" + e["branch"])
    if tip is None:
        return True
    if tip == e.get("start"):
        return False
    for ref in base_refs(e["source"], e["base"]):
        if git("merge-base", "--is-ancestor", tip, ref, cwd=e["source"], check=False).returncode == 0:
            return True
    return False


def activity_time(wsdir, data):
    newest = 0.0
    for dirpath, dirnames, filenames in os.walk(wsdir):
        if dirpath == wsdir and "repos" in dirnames:
            dirnames.remove("repos")
        for f in filenames:
            try:
                st = os.lstat(os.path.join(dirpath, f))
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                newest = max(newest, st.st_mtime)
    for e in data["repos"]:
        r = git("log", "-1", "--format=%ct", "refs/heads/" + e["branch"], cwd=e["source"], check=False)
        if r.returncode == 0 and r.stdout.strip().isdigit():
            newest = max(newest, float(r.stdout.strip()))
    return newest


def workspace_status(wsdir, data, stale_days):
    """(status, missing source paths)."""
    missing = [e["source"] for e in data["repos"] if not repo_ok(e["source"])]
    if missing:
        return "stale", missing
    if data["repos"] and all(entry_merged(e) for e in data["repos"]):
        return "merged", missing
    if time.time() - activity_time(wsdir, data) >= stale_days * DAY:
        return "stale", missing
    return "active", missing


def created_time(wsdir, data):
    t = parse_ts(data.get("created"))
    if t is not None:
        return t
    try:
        return os.path.getmtime(os.path.join(wsdir, WS_FILE))
    except OSError:
        return time.time()


def age_days(t):
    return max(0, int((time.time() - t) // DAY))


def dir_size(path):
    total = 0
    for dirpath, dirnames, filenames in os.walk(path):
        for n in filenames + dirnames:
            try:
                total += os.lstat(os.path.join(dirpath, n)).st_size
            except OSError:
                pass
    return total


def fmt_size(n):
    v, i = float(n), 0
    while v >= 1024 and i < 4:
        v /= 1024
        i += 1
    return f"{int(v)}B" if i == 0 else f"{v:.1f}{'BKMGT'[i]}"


def workspace_dirs():
    root = ws_root()
    if not os.path.isdir(root):
        return []
    return [(n, os.path.join(root, n)) for n in sorted(os.listdir(root))
            if not n.startswith(".") and os.path.isdir(os.path.join(root, n))]


# --- workspace commands -----------------------------------------------------

def cmd_ws_new(a):
    feature = a.feature
    if not valid_feature(feature):
        die(f"invalid feature name '{feature}'")
    branch = a.branch if a.branch is not None else f"feat/{feature}"
    if branch.startswith("-") or git("check-ref-format", "--branch", branch, check=False).returncode:
        die(f"invalid branch name '{branch}'")
    root = ws_root()
    wsdir = os.path.join(root, feature)
    if os.path.lexists(wsdir):
        die(f"workspace {feature} already exists at {wsdir}")
    os.makedirs(root, exist_ok=True)
    try:
        os.mkdir(wsdir)
        os.mkdir(os.path.join(wsdir, "repos"))
        write_json_atomic(os.path.join(wsdir, WS_FILE), {
            "version": 1, "feature": feature, "branch": branch, "created": utc_now(), "repos": []})
    except OSError as e:
        shutil.rmtree(wsdir, ignore_errors=True)
        die(f"can't create workspace {feature}: {e}")
    print(f"team-guard: created workspace {feature} at {wsdir}")
    try:
        n = 0
        stale_days = int_setting(None, "TEAM_STALE_DAYS", 30, "--stale-days")
        for name, d in workspace_dirs():
            if name == feature:
                continue
            if workspace_status(d, load_workspace(d), stale_days)[0] in ("merged", "stale"):
                n += 1
        if n:
            print(f"team-guard: hint: {n} stale workspace(s); run `team-guard gc` to review them", file=sys.stderr)
    except BaseException as e:  # the hint must never change the outcome
        if isinstance(e, KeyboardInterrupt):
            raise


def worktree_holders(source):
    """Map of refs/heads name -> worktree path for every worktree of the repo."""
    holders, path = {}, None
    for line in git("worktree", "list", "--porcelain", cwd=source, check=False).stdout.splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line.startswith("branch "):
            holders[line[len("branch "):]] = path
    return holders


def main_worktree(d):
    for line in git("worktree", "list", "--porcelain", cwd=d, check=False).stdout.splitlines():
        if line.startswith("worktree "):
            return realpath(line[len("worktree "):])
    return None


def cmd_ws_attach(a):
    if a.feature:
        wsdir = named_workspace_or_die(a.feature)
    else:
        wsdir = current_workspace_or_die()
    try:
        data = load_workspace(wsdir)
    except WorkspaceFileError as e:
        workspace_file_die(e)
    feature = os.path.basename(wsdir)
    if data.get("closing"):
        die(f"workspace {feature} is being closed")

    d = nearest_existing_dir(a.repo_path) if os.path.exists(a.repo_path) else None
    if d is None or git("rev-parse", "--git-dir", cwd=d, check=False).returncode:
        if d is not None and git("rev-parse", "--is-bare-repository", cwd=d, check=False).stdout.strip() == "true":
            die(f"{a.repo_path}: bare repositories are not supported")
        die(f"{a.repo_path} is not a git repository")
    if git("rev-parse", "--is-bare-repository", cwd=d, check=False).stdout.strip() == "true":
        die("bare repositories are not supported")
    source = main_worktree(d)
    if not source or not os.path.isdir(source):
        die(f"{a.repo_path} is not a git repository")
    name = os.path.basename(source)
    for e in data["repos"]:
        if e["source"] == source:
            die(f"{source} is already attached to {feature} at {e['worktree']}")
    for e in data["repos"]:
        if e["name"] == name:
            die(f"can't attach {source} as {name}: {e['source']} is already attached as {name}")
    wt = os.path.join(wsdir, "repos", name)
    if os.path.lexists(wt):
        die(f"can't attach {source} as {name}: {wt} already exists")

    branch = data["branch"]
    base = a.base
    if not base:
        head = git("symbolic-ref", "-q", "refs/remotes/origin/HEAD", cwd=source, check=False)
        target = head.stdout.strip()
        base = target[len("refs/remotes/origin/"):] if target.startswith("refs/remotes/origin/") else "main"
    start_ref = next((r for r in ("refs/heads/" + base, "refs/remotes/origin/" + base) if rev_parse(source, r)), None)
    if not start_ref:
        die(f"base branch {base} not found in {source}")
    existing = rev_parse(source, "refs/heads/" + branch)
    if existing:
        holder = worktree_holders(source).get("refs/heads/" + branch)
        if holder:
            die(f"branch {branch} is already checked out in {realpath(holder)}")
    start = existing or rev_parse(source, start_ref)

    undo = []
    try:
        os.makedirs(os.path.join(wsdir, "repos"), exist_ok=True)
        cmd = ["git", "-c", "core.hooksPath=/dev/null", "-C", source, "worktree", "add"]
        cmd += [wt, branch] if existing else ["--no-track", "-b", branch, wt, start_ref]
        if not existing:
            undo.append(lambda: subprocess.run(["git", "-C", source, "branch", "-D", branch],
                                               capture_output=True, stdin=subprocess.DEVNULL))
        undo.append(lambda: subprocess.run(["git", "-C", source, "worktree", "prune"],
                                           capture_output=True, stdin=subprocess.DEVNULL))
        undo.append(lambda: shutil.rmtree(wt, ignore_errors=True))
        undo.append(lambda: subprocess.run(["git", "-C", source, "worktree", "remove", "--force", wt],
                                           capture_output=True, stdin=subprocess.DEVNULL))
        r = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if r.returncode:
            raise RuntimeError("git worktree add failed: " + r.stderr.strip())
        git_dir = realpath(git("rev-parse", "--absolute-git-dir", cwd=wt).stdout.strip())
        pointer = os.path.join(git_dir, POINTER_NAME)
        with open(pointer + ".tmp", "w") as f:
            f.write(wsdir + "\n")
        os.replace(pointer + ".tmp", pointer)
        data["repos"].append({
            "name": name, "source": source, "worktree": realpath(wt), "branch": branch, "base": base,
            "start": start, "reused": bool(existing), "attached": utc_now(), "git_dir": git_dir})
        save_workspace(wsdir, data)
    except BaseException as e:
        # Undo in reverse order; the worktree comes off before the branch it holds.
        for fn in reversed(undo):
            try:
                fn()
            except Exception:
                pass
        if isinstance(e, KeyboardInterrupt):
            raise
        die(f"can't attach {source}: {e}")
    if existing:
        print(f"team-guard: reused existing branch {branch} at {existing[:12]}")
    print(f"team-guard: attached {name} at {realpath(wt)} on {branch} from {base}")


def cmd_ws_list(a):
    stale_days = int_setting(a.stale_days, "TEAM_STALE_DAYS", 30, "--stale-days")
    code = 0
    for feature, d in workspace_dirs():
        if empty_leftover(d):
            continue  # what an interrupted close leaves; `close` or `gc` finishes it
        try:
            data = load_workspace(d)
        except WorkspaceFileError as e:
            print(f"{feature}\tinvalid\t-\t-")
            print(f"team-guard: can't read {e.path} (missing or not valid JSON)", file=sys.stderr)
            code = 1
            continue
        status, _ = workspace_status(d, data, stale_days)
        print(f"{feature}\t{status}\t{age_days(created_time(d, data))}d\t{fmt_size(dir_size(d))}")
    sys.stdout.flush()
    if code:
        sys.exit(code)


def cmd_ws_show(a):
    wsdir = named_workspace_or_die(a.feature) if a.feature else current_workspace_or_die()
    try:
        data = load_workspace(wsdir)
    except WorkspaceFileError as e:
        workspace_file_die(e)
    print(f"workspace: {wsdir}")
    print(f"feature: {data.get('feature', os.path.basename(wsdir))}")
    print(f"branch: {data.get('branch', '')}")
    for e in data["repos"]:
        print(f"repo {e['name']} source={e['source']} worktree={e['worktree']} base={e['base']}")


def copy_if_exists(src, dst):
    if os.path.isfile(src):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)


def move_into(src, dst):
    """Move src to dst; when both are directories, merge."""
    if os.path.isdir(src) and not os.path.islink(src) and os.path.isdir(dst):
        for n in os.listdir(src):
            move_into(os.path.join(src, n), os.path.join(dst, n))
        os.rmdir(src)
        return
    if os.path.lexists(dst):
        if os.path.isdir(dst) and not os.path.islink(dst):
            shutil.rmtree(dst)
        else:
            os.remove(dst)
    shutil.move(src, dst)


def registered_worktrees(src):
    """Realpaths of every worktree the source repo lists."""
    out = git("worktree", "list", "--porcelain", cwd=src, check=False).stdout.splitlines()
    return {realpath(l[len("worktree "):]) for l in out if l.startswith("worktree ")}


def owns_checkout(wt, entry):
    """True when wt/.git is a gitfile naming the git dir recorded at attach time."""
    try:
        with open(os.path.join(wt, ".git")) as f:
            line = f.readline().strip()
    except OSError:
        return False
    return line.startswith("gitdir:") and bool(entry.get("git_dir")) \
        and realpath(line[len("gitdir:"):].strip()) == realpath(entry["git_dir"])


class CloseRefused(Exception):
    def __init__(self, header, problems, force_hint):
        super().__init__(header)
        self.header, self.problems, self.force_hint = header, problems, force_hint


def crit_daemons_under(root):
    """[(pid, cwd)] of live Crit processes whose working directory is inside root (this user's only)."""
    root = realpath(root)
    ps = subprocess.run(["ps", "-ax", "-o", "pid=,command="], capture_output=True, text=True).stdout
    cands = []
    for line in ps.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        if pid.isdigit() and int(pid) != os.getpid() and "crit" in cmd.lower():
            cands.append(int(pid))
    cwds = {}
    for pid in cands:
        if os.path.isdir("/proc/self"):
            try:
                cwds[pid] = os.readlink(f"/proc/{pid}/cwd")
            except OSError:
                pass
    if cands and not cwds:
        try:
            out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(map(str, cands))],
                                 capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        cur = None
        for line in out.splitlines():
            if line.startswith("p") and line[1:].isdigit():
                cur = int(line[1:])
            elif line.startswith("n") and cur is not None:
                cwds[cur] = line[1:]
    return [(pid, cwd) for pid, cwd in sorted(cwds.items()) if under(cwd, root)]


def stop_crit_daemons(wsdir):
    """Stop this workspace's Crit daemons (SIGTERM, up to 5 s), so its gate exports are final before archiving."""
    crit_dir = os.path.join(realpath(wsdir), ".crit")
    if not os.path.isdir(crit_dir):
        return
    for pid, cwd in crit_daemons_under(crit_dir):
        rel = os.path.relpath(realpath(cwd), crit_dir).split(os.sep)
        gate = rel[0] if rel and rel[0] != "." else "?"
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            continue
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.05)
        else:
            warn(f"crit daemon {pid} (gate {gate}) did not stop within 5 seconds")
            continue
        print(f"team-guard: stopped crit daemon {pid} (gate {gate})")


def close_workspace(feature, force=False, cwd=None):
    """Close a workspace: archive artifacts, remove worktrees and holdouts. Raises CloseRefused; exits on failure."""
    wsdir = os.path.join(ws_root(), feature)
    try:
        data = load_workspace(wsdir)
    except WorkspaceFileError as e:
        workspace_file_die(e)
    recorded = [realpath(e["worktree"]) for e in data["repos"]]
    cwd = cwd if cwd is not None else safe_cwd()
    if cwd and (under(cwd, wsdir) or any(under(cwd, w) for w in recorded)):
        raise CloseRefused(f"can't close {feature} from inside it; run it from elsewhere", None, False)

    problems, discard = [], []
    repos_dir = os.path.join(wsdir, "repos")
    blocking = []
    real_repos = os.path.join(realpath(wsdir), "repos")
    expected = {n: os.path.join(real_repos, n) for n in (e["name"] for e in data["repos"])}
    if os.path.lexists(repos_dir):
        for n in sorted(os.listdir(repos_dir)):
            if n not in expected:
                blocking.append((None, f"unrecorded entry in repos/: {n}"))
    for e in data["repos"]:
        wt, src = e["worktree"], e["source"]
        if realpath(wt) != expected[e["name"]]:
            blocking.append((None, f"worktree outside workspace: {realpath(wt)}"))
            continue
        if os.path.isfile(os.path.join(wsdir, e["name"])):
            blocking.append((os.path.join(wsdir, e["name"]), "an artifact file has the name of an attached repo"))
        if not os.path.isdir(wt):
            continue
        if not repo_ok(src):
            if not owns_checkout(wt, e):
                blocking.append((None, f"worktree outside workspace: {realpath(wt)}"))
                continue
            problems.append((wt, "source repository missing"))
            continue
        if realpath(wt) not in registered_worktrees(src):
            blocking.append((None, f"worktree outside workspace: {realpath(wt)}"))
            continue
        if git("status", "--porcelain", cwd=wt, check=False).stdout.strip():
            problems.append((wt, "uncommitted changes"))
        refs = ["HEAD"]
        if rev_parse(src, "refs/heads/" + e["branch"]):
            refs.append("refs/heads/" + e["branch"])
        r = git("rev-list", "-1", *refs, "--not", "--remotes", cwd=wt, check=False)
        if r.returncode == 0 and r.stdout.strip():
            problems.append((wt, "unpushed commits"))
    if blocking or (problems and not force):
        shown = blocking + ([] if force else problems)
        raise CloseRefused(f"can't close {feature}:", shown, bool(problems) and not force)
    discard = list(problems)
    stop_crit_daemons(wsdir)

    closing = data.get("closing")
    if closing and closing.get("archive"):
        archive = closing["archive"]
    else:
        base = os.path.join(archive_root(), feature)
        archive, n = base, 1
        while os.path.lexists(archive):
            n += 1
            archive = f"{base}+{n}"
        closing = None
    os.makedirs(archive, exist_ok=True)
    if not closing:
        shutil.copy2(os.path.join(wsdir, WS_FILE), os.path.join(archive, WS_FILE))
        data["closing"] = {"archive": archive, "started": utc_now(), "forced": bool(force)}
        save_workspace(wsdir, data)

    reasons = {}
    for wt, reason in discard:
        reasons.setdefault(wt, []).append(reason)
    for e in list(data["repos"]):
        wt, src, name = e["worktree"], e["source"], e["name"]
        gd = e.get("git_dir") or ""
        copy_if_exists(os.path.join(gd, LOCK_NAME), os.path.join(archive, name, LOCK_NAME))
        copy_if_exists(os.path.join(gd, "jev-decisions.md"), os.path.join(archive, name, "jev-decisions.md"))
        if os.path.isdir(wt) and not repo_ok(src):
            shutil.rmtree(wt)  # forced: nothing but the checkout is left to remove
            print(f"team-guard: removed worktree {wt}")
            for reason in reasons.get(wt, []):
                print(f"team-guard: discarded {reason} in {wt}")
        elif os.path.isdir(wt):
            for line in git("status", "--porcelain", "--ignored", cwd=wt, check=False).stdout.splitlines():
                if line.startswith("!! "):
                    print(f"team-guard: deleting ignored: {name}/{line[3:]}")
            r = subprocess.run(["git", "-C", src, "worktree", "remove", *(["--force"] if force else []), wt],
                               capture_output=True, text=True, stdin=subprocess.DEVNULL)
            if r.returncode:
                print(f"team-guard: git worktree remove failed for {wt}", file=sys.stderr)
                print(r.stderr.strip(), file=sys.stderr)
                sys.exit(1)
            print(f"team-guard: removed worktree {wt}")
            for reason in reasons.get(wt, []):
                extra = f" (branch {e['branch']} kept)" if reason == "unpushed commits" else ""
                print(f"team-guard: discarded {reason} in {wt}{extra}")
        elif repo_ok(src):
            git("worktree", "prune", cwd=src, check=False)
            print(f"team-guard: pruned missing worktree {wt}")
        else:
            warn(f"source repo {src} is missing; skipped {name}")
        data["repos"] = [x for x in data["repos"] if x["name"] != name]
        save_workspace(wsdir, data)

    hp = os.path.join(holdout_root(), feature)
    marker = os.path.join(hp, HOLDOUT_MARKER)
    if os.path.isdir(hp):
        info = None
        try:
            with open(marker) as f:
                info = json.load(f)
        except (OSError, ValueError):
            pass
        if not isinstance(info, dict):
            warn(f"{hp} is not this workspace's holdout directory; left in place")
        elif info.get("feature") == feature and isinstance(info.get("workspace"), str) \
                and realpath(info["workspace"]) == realpath(wsdir):
            shutil.rmtree(hp)
        else:
            warn(f"holdout {hp} belongs to another workspace root")

    for n in sorted(os.listdir(wsdir)):
        if n in ("repos", WS_FILE, WS_FILE + ".tmp"):
            continue
        move_into(os.path.join(wsdir, n), os.path.join(archive, n))
    meta = {"feature": feature, "closed": utc_now(), "workspace": wsdir, "forced": bool(force),
            "discarded": [{"worktree": wt, "reason": r} for wt, rs in reasons.items() for r in rs]}
    write_json_atomic(os.path.join(archive, "archive.json"), meta)
    # repos/ first, the workspace dir (which holds the `closing` marker) last, so a failure stays resumable.
    if os.path.lexists(repos_dir):
        os.rmdir(repos_dir)
    for n in (WS_FILE, WS_FILE + ".tmp"):
        if os.path.lexists(os.path.join(wsdir, n)):
            os.remove(os.path.join(wsdir, n))
    os.rmdir(wsdir)
    print(f"team-guard: closed {feature}; artifacts archived at {archive}")


def empty_leftover(wsdir):
    """True for an entirely empty, direct child of the workspace root: what an interrupted close leaves."""
    root = ws_root()
    return (os.path.isdir(wsdir) and not os.path.islink(wsdir) and os.path.dirname(realpath(wsdir)) == root
            and not os.path.basename(wsdir).startswith(".") and not os.listdir(wsdir))


def safe_cwd():
    try:
        return realpath(os.getcwd())
    except OSError:
        return None


def cmd_ws_close(a):
    wsdir = named_workspace_or_die(a.feature)
    if empty_leftover(wsdir):
        os.rmdir(wsdir)
        print(f"team-guard: closed {a.feature}; finished an interrupted close")
        return
    try:
        close_workspace(a.feature, a.force)
    except CloseRefused as e:
        if e.problems is None:
            die(e.header)
        lines = [f"team-guard: {e.header}"] + [f"  {p}: {why}" if p else f"  {why}" for p, why in e.problems]
        if e.force_hint:
            lines.append("use --force to remove them anyway (branches are kept)")
        print("\n".join(lines), file=sys.stderr)
        sys.exit(1)


def cmd_workspace(args):
    sub = args[0] if args else ""
    rest = args[1:]
    p = Parser(prog=f"workspace {sub}", add_help=False)
    if sub == "new":
        p.add_argument("feature")
        p.add_argument("--branch")
    elif sub == "attach":
        p.add_argument("repo_path")
        p.add_argument("--base")
        p.add_argument("--feature")
    elif sub == "list":
        p.add_argument("--stale-days", type=int)
    elif sub == "show":
        p.add_argument("feature", nargs="?")
    elif sub == "close":
        p.add_argument("feature")
        p.add_argument("--force", action="store_true")
    else:
        print("team-guard: workspace: expected new|attach|list|show|close\n" + __doc__, file=sys.stderr)
        sys.exit(1)
    a = parse_or_exit(p, rest)
    {"new": cmd_ws_new, "attach": cmd_ws_attach, "list": cmd_ws_list,
     "show": cmd_ws_show, "close": cmd_ws_close}[sub](a)


def cmd_workspace_path(args):
    parse_or_exit(Parser(prog="workspace-path", add_help=False), args)
    ws = resolve_workspace(os.getcwd())
    if ws is None:
        die("not inside a workspace")
    if ws[0] == "dangling":
        die(f"the workspace pointer here is dangling: {ws[1]} has no {WS_FILE}")
    if not os.path.isfile(os.path.join(ws[1], WS_FILE)):
        die(f"can't read {os.path.join(ws[1], WS_FILE)} (missing)")
    print(ws[1])


# --- gc ---------------------------------------------------------------------

def newest_mtime(path):
    newest = os.lstat(path).st_mtime
    for dirpath, dirnames, filenames in os.walk(path):
        for n in dirnames + filenames:
            try:
                newest = max(newest, os.lstat(os.path.join(dirpath, n)).st_mtime)
            except OSError:
                pass
    return newest


def holdout_orphaned(path, name):
    """A marked holdout is orphaned when the workspace that created it no longer has a workspace.json."""
    try:
        with open(os.path.join(path, HOLDOUT_MARKER)) as f:
            owner = json.load(f).get("workspace")
    except (OSError, ValueError, AttributeError):
        owner = None
    if isinstance(owner, str) and owner:
        return not os.path.isfile(os.path.join(owner, WS_FILE))
    return not os.path.isdir(os.path.join(ws_root(), name))


def cmd_gc(args):
    p = Parser(prog="gc", add_help=False)
    p.add_argument("--apply", action="store_true")
    p.add_argument("--stale-days", type=int)
    p.add_argument("--retention-days", type=int)
    a = parse_or_exit(p, args)
    stale_days = int_setting(a.stale_days, "TEAM_STALE_DAYS", 30, "--stale-days")
    retention = int_setting(a.retention_days, "TEAM_ARCHIVE_RETENTION_DAYS", 180, "--retention-days")
    t = time.time()
    code = 0
    items = []  # (order, text, action)

    # Expired archives.
    ar = archive_root()
    if os.path.isdir(ar):
        for n in sorted(os.listdir(ar)):
            d = os.path.join(ar, n)
            meta_path = os.path.join(d, "archive.json")
            if not os.path.isfile(meta_path):
                continue
            try:
                with open(meta_path) as f:
                    closed = parse_ts(json.load(f).get("closed"))
            except (OSError, ValueError, AttributeError):
                closed = None
            if closed is None:
                closed = os.path.getmtime(d)
            if t - closed >= retention * DAY:
                items.append((0, f"would delete archive {d} ({int((t - closed) // DAY)}d old)",
                              lambda d=d: (shutil.rmtree(d), print(f"team-guard: deleted {d}"))))
    # Legacy holdouts, then orphaned workspace holdouts.
    ho = holdout_root()
    legacy, orphans = [], []
    if os.path.isdir(ho):
        for n in sorted(os.listdir(ho)):
            pa = os.path.join(ho, n)
            if os.path.islink(pa) or not os.path.isdir(pa):
                continue
            if os.path.isfile(os.path.join(pa, HOLDOUT_MARKER)):
                if holdout_orphaned(pa, n):
                    orphans.append(pa)
                continue
            for b in sorted(os.listdir(pa)):
                pb = os.path.join(pa, b)
                if os.path.islink(pb) or not os.path.isdir(pb):
                    continue
                untouched = t - newest_mtime(pb)
                if untouched >= retention * DAY:
                    legacy.append((pa, pb, int(untouched // DAY)))
    for pa, pb, days in legacy:
        def drop(pa=pa, pb=pb):
            shutil.rmtree(pb)
            if not os.listdir(pa):
                os.rmdir(pa)
            print(f"team-guard: deleted {pb}")
        items.append((1, f"would delete legacy holdout {pb} ({days}d untouched)", drop))
    for pa in orphans:
        items.append((2, f"would remove orphan holdout {pa} (no workspace)",
                      lambda pa=pa: (shutil.rmtree(pa), print(f"team-guard: removed {pa}"))))
    # Workspaces.
    for feature, d in workspace_dirs():
        if empty_leftover(d):
            items.append((3, f"would remove empty leftover of a closed workspace {d}",
                          lambda d=d: (os.rmdir(d), print(f"team-guard: removed {d}"))))
            continue
        try:
            data = load_workspace(d)
        except WorkspaceFileError as e:
            print(f"team-guard: can't read {e.path} (missing or not valid JSON); leaving {feature} alone", file=sys.stderr)
            code = 1
            continue
        for e in data["repos"]:
            if not repo_ok(e["source"]):
                warn(f"source repo {e['source']} is missing (workspace {feature})")
        age = age_days(created_time(d, data))
        if data.get("closing"):
            text = f"would resume closing {feature}"
        elif data["repos"] and not any(os.path.isdir(e["worktree"]) for e in data["repos"]):
            text = f"would close orphan workspace {feature} (worktrees missing)"
        else:
            status, _ = workspace_status(d, data, stale_days)
            if status not in ("merged", "stale"):
                continue
            text = f"would close {feature} ({status}, {age}d)"
        items.append((3, text, lambda feature=feature: gc_close(feature)))

    if not items:
        print("team-guard: nothing to collect")
        sys.exit(code)
    for _, text, action in sorted(items, key=lambda i: i[0]):
        if not a.apply:
            print(text)
            continue
        try:
            action()
        except SystemExit as e:
            if e.code not in (0, None):
                code = 1
        except Exception as e:  # one item's failure doesn't stop the rest
            print(f"team-guard: gc: {e}", file=sys.stderr)
            code = 1
        sys.stdout.flush()
    sys.exit(code)


def gc_close(feature):
    try:
        close_workspace(feature, force=False)
    except CloseRefused as e:
        if e.problems is None:
            print(f"skipped {feature}: the current directory is inside it")
        else:
            for path, why in e.problems:
                print(f"skipped {feature}: {path}: {why}" if path else f"skipped {feature}: {why}")


# --- workflow tooling --------------------------------------------------------

VARIANTS = ("chore", "bug-fix", "spike", "standard", "full")
RANK = {"chore": 0, "bug-fix": 1, "standard": 2, "full": 3}
ANSWER_KEYS = ("repos", "files", "contract", "persisted", "security", "cross_team", "revertible", "user_visible",
               "design_question", "repro")
YES_NO = ("yes", "no", "unknown")
FILES_BUCKETS = ("<=3", "4-15", ">15", "unknown")
STEP_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
ROUTING_NOTES = "routing.md"


class _ArgError(Exception):
    pass


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        raise _ArgError(message)


def _parse_or_die(parser, args, label):
    try:
        return parser.parse_args(args)
    except _ArgError as e:
        die(f"{label}: {e}")


def tool_targets(base_arg, label):
    """([(name, top, base)], in_workspace, workspace dir) for the current workspace or repo; exits 1 otherwise."""
    ws = resolve_workspace(os.getcwd())
    if ws and ws[0] == "ok":
        out = []
        for e in load_workspace(ws[1])["repos"]:
            wt = e["worktree"]
            ids = repo_ids(wt) if os.path.isdir(wt) else None
            if not ids or ids[0] != realpath(wt):
                die(f"{label}: {e['name']}: repository unavailable: {wt}")
            out.append((e["name"], ids[0], base_arg or e["base"]))
        return out, True, ws[1]
    r = repo_for_path(os.getcwd())
    if not r:
        die("not a git repository")
    if not base_arg:
        die(f"{label}: --base is required outside a workspace")
    return [(os.path.basename(r[0]), r[0], base_arg)], False, None


def merge_base_or_die(top, base, label, name):
    ok = git("rev-parse", "--verify", "--quiet", base + "^{commit}", cwd=top, check=False)
    mb = git("merge-base", base, "HEAD", cwd=top, check=False) if ok.returncode == 0 else None
    if mb is None or mb.returncode != 0 or not mb.stdout.strip():
        die(f"{label}: {name}: unknown base {base!r}")
    return mb.stdout.strip()


def glob_re(pattern):
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out += "(?:.*/)?"
            i += 3
        elif pattern.startswith("**", i):
            out += ".*"
            i += 2
        elif pattern[i] == "*":
            out += "[^/]*"
            i += 1
        elif pattern[i] == "?":
            out += "[^/]"
            i += 1
        else:
            out += re.escape(pattern[i])
            i += 1
    return re.compile("^" + out + "$")


# --- refs ---

REF_PATTERNS = (
    ("criterion-id", r"(?<![a-z0-9])ac[-_]?\d+"),
    ("section-mark", "§\\s?\\d"),
    ("workflow-file", r"(?<![a-z0-9])(?:contract|spec|architecture|brief|design-gate|questions|followups|routing)\.md"),
    ("addendum", r"addendum"),
    ("review-round", r"(?<![a-z])round[\s_-]?\d"),
    ("adr-number", r"(?<![a-z0-9])adr[\s-]?\d+"),
)
LOCKFILE_GLOBS = ("**/go.sum", "**/package-lock.json", "**/pnpm-lock.yaml", "**/yarn.lock", "**/*.lock")
LOCKFILE_RES = [glob_re(g) for g in LOCKFILE_GLOBS]
REF_DEFAULT_EXCLUDES = ("docs/**", "**/*.md", "**/*.rst", "**/*.txt", "dist/**") + LOCKFILE_GLOBS


def is_lockfile(path):
    return any(r.match(path) for r in LOCKFILE_RES)


REF_CONFIG_KEYS = ("patterns", "disable_patterns", "exclude")


def load_refs_config(path):
    """(patterns, exclude globs) from a config file; exits 1 naming the file on any problem."""
    builtin = dict(REF_PATTERNS)
    patterns = [(n, re.compile(r, re.I)) for n, r in REF_PATTERNS]
    exclude = list(REF_DEFAULT_EXCLUDES)
    if not path:
        return patterns, exclude

    def bad(why):
        die(f"refs: config {path}: {why}")

    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
    except OSError as e:
        bad(f"can't read it ({e.strerror or e})")
    except ValueError as e:
        bad(f"not valid JSON ({e})")
    if not isinstance(cfg, dict):
        bad("expected a JSON object")
    for k in cfg:
        if k not in REF_CONFIG_KEYS:
            bad(f"unknown key {k!r}")
    disabled = cfg.get("disable_patterns", [])
    if not isinstance(disabled, list) or not all(isinstance(x, str) for x in disabled):
        bad("disable_patterns must be a list of pattern names")
    for x in disabled:
        if x not in builtin:
            bad(f"unknown pattern name {x!r} in disable_patterns")
    patterns = [(n, r) for n, r in patterns if n not in disabled]
    extra = cfg.get("patterns", [])
    if not isinstance(extra, list):
        bad("patterns must be a list of {name, regex} objects")
    for item in extra:
        if (not isinstance(item, dict) or set(item) != {"name", "regex"}
                or not isinstance(item["name"], str) or not isinstance(item["regex"], str) or not item["name"]):
            bad("each pattern must be an object with a string name and a string regex")
        try:
            patterns.append((item["name"], re.compile(item["regex"], re.I)))
        except re.error as e:
            bad(f"bad regex for pattern {item['name']!r}: {e}")
    if "exclude" in cfg:
        ex = cfg["exclude"]
        if not isinstance(ex, list) or not all(isinstance(x, str) for x in ex):
            bad("exclude must be a list of globs")
        exclude = ex
    return patterns, exclude


def changed_lines_of(top, mb):
    """({path: [(line number, text)]} for added lines, set of binary paths) since mb, working tree included."""
    lines, binary = {}, set()
    diff = git("-c", "core.quotePath=false", "diff", "-U0", "--no-color", "--no-ext-diff", "--no-textconv", "-M",
               "--src-prefix=a/", "--dst-prefix=b/", mb, cwd=top).stdout
    cur, skip, in_hunk, n = None, False, False, 0
    for line in diff.split("\n"):
        if line.startswith("diff --git "):
            cur, skip, in_hunk = None, False, False
            m = re.match(r"^diff --git a/(.+) b/(.+)$", line)
            if m and m.group(1) == m.group(2):
                cur = m.group(2)
            continue
        if not in_hunk:
            if line.startswith("deleted file mode"):
                skip = True
            elif line.startswith("rename to "):
                cur = line[len("rename to "):]
            elif line.startswith("+++ b/"):
                cur = line[len("+++ b/"):]
            elif line.startswith("Binary files "):
                m = re.match(r"^Binary files (?:/dev/null|a/.+) and (?:/dev/null|b/(.+)) differ$", line)
                if m and m.group(1):
                    binary.add(m.group(1))
                    cur = m.group(1)
            if cur and not skip:
                lines.setdefault(cur, [])
        if line.startswith("@@"):
            m = re.match(r"^@@ -\S+ \+(\d+)", line)
            in_hunk, n = True, int(m.group(1)) if m else 0
        elif in_hunk and line.startswith("+") and cur and not skip:
            lines.setdefault(cur, []).append((n, line[1:]))
            n += 1
    for path in git("ls-files", "--others", "--exclude-standard", "-z", cwd=top).stdout.split("\0"):
        if not path:
            continue
        full = os.path.join(top, path)
        if not os.path.isfile(full) or os.path.islink(full):
            continue
        with open(full, "rb") as f:
            data = f.read()
        if b"\0" in data[:8000]:
            binary.add(path)
            lines.setdefault(path, [])
            continue
        text = data.decode("utf-8", errors="replace")
        rows = text.split("\n")
        if rows and rows[-1] == "":
            rows.pop()
        lines[path] = list(enumerate(rows, start=1))
    return lines, binary


def cmd_refs(args):
    p = _Parser(prog="team-guard refs", add_help=False)
    p.add_argument("--base")
    p.add_argument("--config")
    a = _parse_or_die(p, args, "refs")
    patterns, exclude = load_refs_config(a.config or os.environ.get("TEAM_REFS_CONFIG") or None)
    skips = [glob_re(g) for g in exclude]
    targets, in_ws, _ = tool_targets(a.base, "refs")
    findings = []
    for name, top, base in targets:
        mb = merge_base_or_die(top, base, "refs", name)
        lines, binary = changed_lines_of(top, mb)
        rows = []
        for path, added in lines.items():
            if path in binary or any(g.match(path) for g in skips):
                continue
            for pname, rx in patterns:
                if rx.search(path):
                    rows.append((path, 0, pname, f"{path}: {pname}: file name"))
            for n, text in added:
                for pname, rx in patterns:
                    if rx.search(text):
                        rows.append((path, n, pname, f"{path}:{n}: {pname}: {text.strip()}"))
        rows.sort(key=lambda r: r[:3])
        findings += [(f"{name}: " if in_ws else "") + r[3] for r in rows]
    if not findings:
        print("team-guard: refs: no workflow references in changed lines")
        return
    print("\n".join(findings) + f"\nteam-guard: refs: {len(findings)} finding(s)", file=sys.stderr)
    sys.exit(2)


# --- the routing log ---

def log_path():
    return os.path.join(_root("TEAM_LOG_ROOT", "~/.agentic-workflow"), "routing-log.jsonl")


def parse_answer_items(items, label):
    answers = {k: "unknown" for k in ANSWER_KEYS}
    for item in items:
        key, sep, value = item.partition("=")
        if not sep or key not in ANSWER_KEYS:
            die(f"{label}: unknown answer {item!r}; keys are {', '.join(ANSWER_KEYS)}")
        if key == "repos":
            if value != "unknown":
                if not value.isdigit() or int(value) < 1:
                    die(f"{label}: repos must be an integer of at least 1 or unknown, not {value!r}")
                value = int(value)
        elif key == "files":
            if value not in FILES_BUCKETS:
                die(f"{label}: files must be one of {', '.join(FILES_BUCKETS)}, not {value!r}")
        elif value not in YES_NO:
            die(f"{label}: {key} must be yes, no or unknown, not {value!r}")
        answers[key] = value
    return answers


def feature_for(name, label):
    ws = resolve_workspace(os.getcwd())
    if not name and ws and ws[0] == "ok":
        name = load_workspace(ws[1]).get("feature")
    if not name:
        die(f"{label}: --feature is required outside a workspace")
    if not valid_feature(name):
        die(f"{label}: invalid feature name {name!r}")
    return name


def notes_dir():
    """Where routing notes go: the workspace dir, else the git dir, else nowhere."""
    ws = resolve_workspace(os.getcwd())
    if ws and ws[0] == "ok":
        return ws[1]
    r = repo_for_path(os.getcwd())
    return r[1] if r else None


def read_events(raw):
    """(valid v1 event objects, malformed line count) from the log's bytes."""
    events, bad = [], 0
    for line in raw.decode("utf-8", errors="replace").split("\n"):
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            bad += 1
            continue
        if not isinstance(obj, dict) or obj.get("v") != 1:
            bad += 1
            continue
        events.append(obj)
    return events, bad


def current_variant(events, feature):
    cur = None
    for e in events:
        if e.get("feature") != feature:
            continue
        if e.get("event") == "route":
            cur = e.get("confirmed")
        elif e.get("event") == "upgrade":
            cur = e.get("to")
    return cur


def append_locked(build, notes_line=None):
    """Append one event under an exclusive lock. build(events) returns the event dict (or exits)."""
    path = log_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        size = os.fstat(fd).st_size
        raw = os.pread(fd, size, 0) if size else b""
        event = build(read_events(raw)[0])
        data = (json.dumps(event, ensure_ascii=False) + "\n").encode("utf-8")
        if raw and not raw.endswith(b"\n"):
            data = b"\n" + data
        os.write(fd, data)
        nd = notes_dir() if notes_line else None
        if nd:
            with open(os.path.join(nd, ROUTING_NOTES), "a", encoding="utf-8") as f:
                f.write(notes_line(event).replace("\r", " ") + "\n")
        return event
    finally:
        os.close(fd)


def one_line(text):
    return " ".join(str(text).split())


def cmd_routing(args):
    if args[:1] == ["summary"]:
        return cmd_routing_summary(args[1:])
    if args[:1] != ["record"] or len(args) < 2 or args[1] not in ("route", "step", "upgrade"):
        die("routing: expected `record route|step|upgrade` or `summary`")
    kind, label = args[1], "routing record " + args[1]
    p = _Parser(prog="team-guard " + label, add_help=False)
    p.add_argument("--feature")
    if kind == "route":
        p.add_argument("--proposed", required=True, choices=VARIANTS)
        p.add_argument("--confirmed", required=True, choices=VARIANTS)
        p.add_argument("--answer", action="append", default=[])
        p.add_argument("--override-reason")
    elif kind == "step":
        p.add_argument("--step", required=True)
        p.add_argument("--seconds", required=True, type=int)
    else:
        p.add_argument("--to", required=True, choices=VARIANTS)
        p.add_argument("--reason", required=True)
    a = _parse_or_die(p, args[2:], label)
    feature = feature_for(a.feature, label)
    if kind == "route":
        answers = parse_answer_items(a.answer, label)
        if a.confirmed != a.proposed and not a.override_reason:
            die(f"{label}: --confirmed differs from --proposed, so --override-reason is required")

        def build(events):
            e = {"v": 1, "ts": utc_now(), "event": "route", "feature": feature, "answers": answers,
                 "proposed": a.proposed, "confirmed": a.confirmed}
            if a.override_reason:
                e["override_reason"] = a.override_reason
            return e

        def note(e):
            extra = f" override-reason={one_line(e['override_reason'])!r}" if "override_reason" in e else ""
            facts = " ".join(f"{k}={e['answers'][k]}" for k in ANSWER_KEYS)
            return f"- {e['ts']} route {feature}: proposed={e['proposed']} confirmed={e['confirmed']}{extra} {facts}"
    elif kind == "step":
        if not STEP_RE.match(a.step):
            die(f"{label}: --step must be lowercase letters, digits and hyphens, not {a.step!r}")
        if a.seconds < 0:
            die(f"{label}: --seconds must be an integer of at least 0")

        def build(events):
            return {"v": 1, "ts": utc_now(), "event": "step", "feature": feature, "step": a.step,
                    "seconds": a.seconds}

        def note(e):
            return f"- {e['ts']} step {feature}: step={e['step']} seconds={e['seconds']}"
    else:
        def build(events):
            cur = current_variant(events, feature)
            if cur is None:
                die(f"{label}: no earlier route is recorded for {feature}")
            if cur not in RANK or a.to not in RANK:
                die(f"{label}: a spike is never upgraded; re-run as standard or full")
            if RANK[a.to] <= RANK[cur]:
                die(f"{label}: {a.to} does not rank above the current variant {cur}; a variant is never downgraded")
            return {"v": 1, "ts": utc_now(), "event": "upgrade", "feature": feature, "from": cur, "to": a.to,
                    "reason": a.reason}

        def note(e):
            return f"- {e['ts']} upgrade {feature}: from={e['from']} to={e['to']} reason={one_line(e['reason'])!r}"
    append_locked(build, note)
    print(f"team-guard: recorded {kind} for {feature}")


def cmd_routing_summary(args):
    p = _Parser(prog="team-guard routing summary", add_help=False)
    p.add_argument("--json", action="store_true")
    a = _parse_or_die(p, args, "routing summary")
    try:
        with open(log_path(), "rb") as f:
            raw = f.read()
    except OSError:
        raw = b""
    events, bad = read_events(raw)
    routes, steps, upgrades = {}, {}, {}
    for e in events:
        feat, kind = e.get("feature"), e.get("event")
        if kind == "route":
            if (not isinstance(feat, str) or e.get("proposed") not in VARIANTS
                    or e.get("confirmed") not in VARIANTS):
                bad += 1
                continue
            routes[feat] = e
        elif kind == "step" and isinstance(feat, str) and isinstance(e.get("seconds"), int):
            steps[feat] = steps.get(feat, 0) + e["seconds"]
        elif kind == "upgrade" and isinstance(feat, str) and e.get("to") in VARIANTS:
            upgrades.setdefault(feat, []).append(e["to"])
    up = down = lateral = 0
    by_variant = {}
    for feat, e in routes.items():
        prop, conf = e["proposed"], e["confirmed"]
        if prop != conf:
            if prop == "spike" or conf == "spike":
                lateral += 1
            elif RANK[conf] > RANK[prop]:
                up += 1
            else:
                down += 1
        final = upgrades[feat][-1] if feat in upgrades else conf
        slot = by_variant.setdefault(final, {"runs": 0, "total_seconds": 0})
        slot["runs"] += 1
        slot["total_seconds"] += steps.get(feat, 0)
    runs = len(routes)
    upgraded = sum(1 for f in routes if f in upgrades)
    out = {
        "runs": runs, "overrides": up + down + lateral, "overrides_up": up, "overrides_down": down,
        "overrides_lateral": lateral,
        "override_rate": (up + down + lateral) / runs if runs else None,
        "upgraded_runs": upgraded, "upgrade_rate": upgraded / runs if runs else None,
        "time_by_variant": {v: {"runs": by_variant[v]["runs"], "total_seconds": by_variant[v]["total_seconds"],
                                "mean_seconds": round(by_variant[v]["total_seconds"] / by_variant[v]["runs"], 1)}
                            for v in VARIANTS if v in by_variant},
        "malformed_lines": bad,
    }
    if a.json:
        print(json.dumps(out, indent=2))
        return
    for k, v in out.items():
        if isinstance(v, dict):
            for var, fields in v.items():
                for f, x in fields.items():
                    print(f"{k}.{var}.{f}: {x}")
        else:
            print(f"{k}: {'n/a' if v is None else v}")


# --- risk ---

RISK_CATEGORIES = ("test", "migration_or_schema", "auth_or_security", "config_or_ci", "docs", "other")
TEST_SEGMENTS = {"test", "tests", "__tests__", "testdata", "spec"}
AUTH_TOKENS = {"auth", "oauth", "security", "permission", "permissions", "rbac", "secret", "secrets", "crypto"}
CONFIG_SEGMENTS = {".github", ".circleci", "deploy", "deployment", "deployments", "helm", "k8s", "terraform"}
CONFIG_EXTS = {".yml", ".yaml", ".toml", ".ini", ".cfg", ".conf", ".env", ".tf"}
DOC_EXTS = {".md", ".rst", ".txt", ".adoc"}
RISK_REASONS = {
    "persisted-data": "changes stored data or its format, which a revert may not undo",
    "breaking-contract": "may break a public interface that others rely on",
    "several-repos": "spans several repositories that must ship together",
    "security": "touches security-sensitive code",
    "hard-to-revert": "a plain revert may not undo it",
    "additive-contract": "adds to a public interface that others rely on",
    "user-visible": "changes behavior users can see",
    "config-or-ci": "changes deploy, CI or configuration files",
}
RISK_PROCESS_ONLY = "extra checks during development flagged this change for a closer look"
RISK_LOW = "docs, tests or an internal change"
DEFAULT_PR_BUDGET = 400
GENERATED_SUFFIXES = ("_gen.go", ".gen.ts", ".pb.go", "_pb2.py")


def path_category(path):
    low = path.lower()
    parts = low.split("/")
    segs, base = parts[:-1], parts[-1]
    ext = os.path.splitext(base)[1]
    if (set(parts) & TEST_SEGMENTS) or base.startswith("test_") or re.search(r"_test\.[^/]*$", base) \
            or re.search(r"\.(test|spec)\.[^/]*$", base):
        return "test"
    if (set(parts) & {"migration", "migrations", "migrate"}) or ext in (".sql", ".proto") or base.startswith("schema"):
        return "migration_or_schema"
    if set(t for t in re.split(r"[^a-z0-9]+", low) if t) & AUTH_TOKENS:
        return "auth_or_security"
    if (set(segs) & CONFIG_SEGMENTS) or base.startswith(("dockerfile", "docker-compose")) \
            or base in ("makefile", ".gitlab-ci.yml") or ext in CONFIG_EXTS:
        return "config_or_ci"
    if (set(segs) & {"doc", "docs"}) or ext in DOC_EXTS:
        return "docs"
    return "other"


def is_generated(path):
    parts = path.split("/")
    base = parts[-1].lower()
    return "dist" in parts[:-1] or base.endswith(GENERATED_SUFFIXES) or base.startswith("zz_generated")


def pr_budget_or_die(flag):
    """The review budget: the flag, else TEAM_PR_BUDGET, else the default. The flag wins without reading the variable."""
    if flag is not None:
        val, src = flag, "--pr-budget"
    else:
        val, src = os.environ.get("TEAM_PR_BUDGET", ""), "TEAM_PR_BUDGET"
        if val == "":
            return DEFAULT_PR_BUDGET
    if not re.fullmatch(r"[0-9]+", val) or int(val) < 1:
        die(f"risk: {src} must be a whole number of at least 1")
    return int(val)


def repo_change_facts(top, mb):
    """[(path, added, removed)] for every changed path since mb, working tree and untracked files included."""
    rows = {}
    out = git("diff", "--numstat", "-z", "--no-renames", "--no-ext-diff", mb, cwd=top).stdout
    for rec in out.split("\0"):
        if not rec:
            continue
        add, _, rest = rec.partition("\t")
        rem, _, path = rest.partition("\t")
        rows[path] = (int(add) if add.isdigit() else 0, int(rem) if rem.isdigit() else 0)
    for path in git("ls-files", "--others", "--exclude-standard", "-z", cwd=top).stdout.split("\0"):
        full = os.path.join(top, path)
        if not path or not os.path.isfile(full) or os.path.islink(full):
            continue
        with open(full, "rb") as f:
            data = f.read()
        n = 0 if b"\0" in data[:8000] else data.count(b"\n") + (1 if data and not data.endswith(b"\n") else 0)
        rows[path] = (n, 0)
    return [(p, a, r) for p, (a, r) in rows.items()]


def latest_answers(feature):
    try:
        with open(log_path(), "rb") as f:
            events = read_events(f.read())[0]
    except OSError:
        return {}
    got = {}
    for e in events:
        if e.get("event") == "route" and e.get("feature") == feature and isinstance(e.get("answers"), dict):
            got = e["answers"]
    return got


def cmd_risk(args):
    p = _Parser(prog="team-guard risk", add_help=False)
    p.add_argument("--base")
    p.add_argument("--feature")
    p.add_argument("--answer", action="append", default=[])
    p.add_argument("--contract", choices=("none", "additive", "breaking", "unknown"))
    p.add_argument("--majors-fixed", type=int, default=0)
    p.add_argument("--holdouts-failed", type=int, default=0)
    p.add_argument("--mutation-skipped", choices=YES_NO, default="no")
    p.add_argument("--human-level", choices=("high", "medium", "low"))
    p.add_argument("--pr-budget")
    p.add_argument("--packet", action="store_true")
    p.add_argument("--no-log", action="store_true")
    a = _parse_or_die(p, args, "risk")
    budget = pr_budget_or_die(a.pr_budget)
    if a.majors_fixed < 0 or a.holdouts_failed < 0:
        die("risk: --majors-fixed and --holdouts-failed must be integers of at least 0")
    overrides = parse_answer_items(a.answer, "risk")
    given = {k for k in (i.partition("=")[0] for i in a.answer)}
    targets, in_ws, _ = tool_targets(a.base, "risk")
    feature = feature_for(a.feature, "risk")
    answers = {k: "unknown" for k in ANSWER_KEYS}
    for k, v in latest_answers(feature).items():
        if k == "repos":
            ok = v == "unknown" or (type(v) is int and v >= 1)
        elif k == "files":
            ok = isinstance(v, str) and v in FILES_BUCKETS
        else:
            ok = isinstance(v, str) and v in YES_NO
        if k in answers and ok:
            answers[k] = v
    for k in given:
        answers[k] = overrides[k]

    cats = {c: 0 for c in RISK_CATEGORIES}
    files = non_test = review = changed_repos = unseals = 0
    for name, top, base in targets:
        mb = merge_base_or_die(top, base, "risk", name)
        rows = repo_change_facts(top, mb)
        if rows:
            changed_repos += 1
        for path, add, rem in rows:
            files += 1
            cat = path_category(path)
            cats[cat] += 1
            if cat != "test":
                non_test += add + rem
                if not is_generated(path) and not is_lockfile(path):
                    review += add + rem
        ids = repo_ids(top)
        unseals += sum(1 for h in load_lock(ids[1])["history"] if h.get("action") == "unseal")

    def risky(key, bad=("yes", "unknown")):
        return answers[key] in bad

    if a.contract:
        contract = a.contract
    else:
        contract = "none" if answers["contract"] == "no" else "unknown"
    rules = []  # (id, level, is_scope)
    if risky("persisted") or cats["migration_or_schema"] >= 1:
        rules.append(("persisted-data", "high", True))
    if contract in ("breaking", "unknown"):
        rules.append(("breaking-contract", "high", True))
    if changed_repos > 1:
        rules.append(("several-repos", "high", True))
    if risky("security") or cats["auth_or_security"] >= 1:
        rules.append(("security", "high", True))
    if risky("revertible", ("no", "unknown")):
        rules.append(("hard-to-revert", "high", True))
    if contract == "additive":
        rules.append(("additive-contract", "medium", True))
    if risky("user_visible"):
        rules.append(("user-visible", "medium", True))
    over = review > budget
    if files > 15 or over:
        rules.append(("large-change", "medium", True))
    if cats["config_or_ci"] >= 1:
        rules.append(("config-or-ci", "medium", True))
    if a.majors_fixed >= 1:
        rules.append(("majors-fixed", "medium", False))
    if unseals >= 1:
        rules.append(("unseal", "medium", False))
    if a.mutation_skipped in ("yes", "unknown"):
        rules.append(("mutation-skipped", "medium", False))
    if a.holdouts_failed >= 1:
        rules.append(("holdouts-failed", "medium", False))
    level = "high" if any(r[1] == "high" for r in rules) else "medium" if rules else "low"
    at_level = [r for r in rules if r[1] == level and r[0] != "large-change"]
    scope = [RISK_REASONS[r[0]] for r in at_level if r[2]]
    if level == "low":
        reason = RISK_LOW
    elif scope:
        reason = "; ".join(scope[:2])
    elif at_level:
        reason = RISK_PROCESS_ONLY
    else:
        reason = None
    lines = [f"Merge risk: {level} (advisory)" + (f" — {reason}." if reason else ".")]

    inputs = dict(answers)
    inputs.update({"contract": contract, "files": files, "non_test_lines": non_test, "repos_changed": changed_repos,
                   "review_lines": review, "pr_budget": budget, "over_budget": "yes" if over else "no", "unseals": unseals, "majors_fixed": a.majors_fixed, "holdouts_failed": a.holdouts_failed,
                   "mutation_skipped": a.mutation_skipped})
    for c, n in cats.items():
        inputs["category." + c] = n
    if a.packet:
        lines.append("")
        lines += [f"rule {r[0]}: {r[1]}" for r in rules]
        lines += [f"input {k}: {inputs[k]}" for k in sorted(inputs)]
    if not a.no_log:
        def build(events):
            e = {"v": 1, "ts": utc_now(), "event": "risk", "feature": feature, "level": level,
                 "rules": [r[0] for r in rules],
                 "inputs": {"answers": answers, "contract": contract, "files": files, "non_test_lines": non_test,
                            "review_lines": review, "over_budget": "yes" if over else "no",
                            "repos_changed": changed_repos, "unseals": unseals, "majors_fixed": a.majors_fixed,
                            "holdouts_failed": a.holdouts_failed, "mutation_skipped": a.mutation_skipped,
                            "categories": cats}}
            if a.human_level:
                e["human_level"] = a.human_level
            return e
        append_locked(build)
    if over:
        lines.append(f"Review-size warning: {review} changed lines to review exceeds the review budget of {budget}; "
                     "split before asking for review.")
    print("\n".join(lines))


# --- sign ---

def sign_problem(top, git_dir):
    """Why this repo can't be re-signed safely, or None."""
    if any(os.path.exists(os.path.join(git_dir, d)) for d in ("rebase-merge", "rebase-apply")):
        return "a rebase is in progress"
    if os.path.exists(os.path.join(git_dir, "MERGE_HEAD")):
        return "a merge is in progress"
    if git("symbolic-ref", "-q", "HEAD", cwd=top, check=False).returncode != 0:
        return "HEAD is detached"
    if git("status", "--porcelain", "--untracked-files=no", cwd=top).stdout.strip():
        return "has uncommitted changes to tracked files"
    return None


def sign_repo(name, top, base):
    """Re-sign base..HEAD in one repo. Returns the success message; exits 1 (branch restored) on failure."""
    def fail(why):
        die(f"sign: {name}: {why}")

    def restore(orig):
        if git("rev-parse", "HEAD", cwd=top).stdout.strip() != orig:
            git("reset", "--hard", "--quiet", orig, cwd=top, check=False)

    orig = git("rev-parse", "HEAD", cwd=top).stdout.strip()
    rng = f"{base}..HEAD"
    if git("rev-parse", "--verify", "--quiet", base + "^{commit}", cwd=top, check=False).returncode != 0:
        fail(f"unknown base {base!r}")
    commits = git("rev-list", rng, cwd=top).stdout.split()
    if not commits:
        return f"team-guard: sign: {name}: nothing to sign"
    trees0 = git("log", "--reverse", "--topo-order", "--format=%T", rng, cwd=top).stdout.split()
    r = git("rebase", "--keep-base", "--rebase-merges", "--empty=keep", "--exec",
            "git commit --amend --allow-empty --no-edit -S", base, cwd=top, check=False)
    if r.returncode != 0:
        git("rebase", "--abort", cwd=top, check=False)
        restore(orig)
        detail = " ".join((r.stderr or r.stdout).split())[-300:]
        fail(f"the signing rebase failed and the branch was restored ({detail})")
    def check():
        """Why the rewritten branch is not acceptable, or None. Any git failure here raises CalledProcessError."""
        now_commits = git("rev-list", rng, cwd=top).stdout.split()
        if any("\ngpgsig " not in git("cat-file", "commit", c, cwd=top).stdout for c in now_commits):
            return "some commits are still unsigned"
        if git("log", "--reverse", "--topo-order", "--format=%T", rng, cwd=top).stdout.split() != trees0 \
                or len(now_commits) != len(commits):
            return "the rewritten commits differ from the originals"
        if git("diff", "--quiet", orig, "HEAD", cwd=top, check=False).returncode != 0:
            return "the rewritten branch differs from the original in content"
        if verified:
            # A verifier that exits without reading the signed payload can make git die of SIGPIPE, so a
            # failed run of this check is a failed check rather than a clean result.
            marks = git("log", "--format=%G?", rng, cwd=top).stdout.split()
            if any(m not in ("G", "U") for m in marks):
                return "a signature did not verify"
        return None

    fmt = git("config", "--get", "gpg.format", cwd=top, check=False).stdout.strip()
    allowed = git("config", "--get", "gpg.ssh.allowedSignersFile", cwd=top, check=False).stdout.strip()
    verified = fmt in ("", "openpgp") or (fmt == "ssh" and bool(allowed))
    try:
        problem = check()
    except subprocess.CalledProcessError as e:
        why = " ".join((e.stderr or "").split())[-300:] or (
            f"git exited with signal {-e.returncode}" if e.returncode < 0 else f"git exited with status {e.returncode}")
        problem = f"could not check the rewritten branch (git {' '.join(e.cmd[1:3])}: {why})"
    if problem:
        restore(orig)
        fail(problem + "; the branch was restored")
    note = "; signatures present, not verified (set gpg.ssh.allowedSignersFile to verify them)" \
        if fmt == "ssh" and not allowed else ""
    return f"team-guard: sign: {name}: signed {len(commits)} commit(s){note}"


# --- design gates: local Crit reviews, their exports, and the approval record ---

GATE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
GATE_RECORD = "design-gate" + "." + "md"
GATE_HEADING = re.compile(r"^## (?P<name>.+?): approved (?P<date>\d{4}-\d{2}-\d{2})\b")
HASH_LINE = re.compile(r"^([0-9a-f]{64})  (\S.*)$")
SESSION_RE = re.compile(r"\(session ([^,)]+)")
CRIT_ENV = {"CRIT_NO_UPDATE_CHECK": "1", "CRIT_PLAN_REVIEW": "off", "CRIT_SHARE_URL": ""}


def gate_context(name, label):
    """(gate, workspace realpath) for the cwd; exits 1 for a bad gate name or outside a workspace."""
    if name is not None and not GATE_RE.match(name):
        die(f"{label}: invalid gate name {name!r}")
    ws = resolve_workspace(os.getcwd())
    if not ws or ws[0] != "ok":
        die(f"{label}: no workspace found; run this from a workspace dir or an attached worktree")
    return realpath(ws[1])


def chat_literal(gate):
    return "approve " + (gate if gate in ("D1", "D2") else "design")


def crit_bin():
    return os.environ.get("CRIT_BIN") or "crit"


def crit_available():
    b = crit_bin()
    if os.sep in b:
        return os.path.isfile(b) and os.access(b, os.X_OK)
    return shutil.which(b) is not None


def require_crit(gate, code=3):
    if not crit_available():
        if gate in ("design", "D1", "D2"):
            print(f'team-guard: gate {gate}: Crit is unavailable; use the chat fallback: the reply that approves '
                  f'this gate is exactly "{chat_literal(gate)}"', file=sys.stderr)
        else:
            print(f'team-guard: gate {gate}: Crit is unavailable; post the questions in chat instead',
                  file=sys.stderr)
        sys.exit(code)


def crit_env():
    env = dict(os.environ)
    env.update(CRIT_ENV)
    return env


def crit_out_dir(ws):
    return os.path.join(ws, ".crit")


def gate_state_path(ws, gate):
    return os.path.join(crit_out_dir(ws), f"gate-{gate}.json")


def load_gate_state(ws, gate):
    try:
        with open(gate_state_path(ws, gate)) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else None
    except (OSError, ValueError):
        return None


def save_gate_state(ws, gate, state):
    os.makedirs(crit_out_dir(ws), exist_ok=True)
    write_json_atomic(gate_state_path(ws, gate), state)


def artifact_paths(ws, names, label):
    """Normalized workspace-relative paths for regular files inside the workspace; exits 1 otherwise."""
    out = []
    for n in names:
        cand = n if os.path.isabs(n) else os.path.join(ws, n)
        try:
            real = os.path.realpath(cand)
        except (ValueError, OSError):
            die(f"{label}: can't resolve {n!r}")
        if not os.path.isfile(real):
            die(f"{label}: {n!r} is not a regular file")
        if not under(real, ws):
            die(f"{label}: {n!r} is outside the workspace")
        lexical = os.path.normpath(cand)
        rel = os.path.relpath(lexical if os.path.commonpath([lexical, ws]) == ws else real, ws)
        out.append(rel.replace(os.sep, "/"))
    return out


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def comment_count(data):
    n = 0
    for e in data:
        n += 1
        if isinstance(e, dict) and isinstance(e.get("replies"), list):
            n += len(e["replies"])
    return n


def unresolved_count(data):
    return sum(1 for e in data if not (isinstance(e, dict) and e.get("resolved") is True))


class GateRun:
    """Exports and failures shared by one gate command."""

    def __init__(self, ws, gate):
        self.ws, self.gate, self.failed, self.fresh = ws, gate, False, []

    def _comments(self, argv, cwd):
        try:
            r = subprocess.run([crit_bin(), *argv], cwd=cwd, env=crit_env(), capture_output=True, text=True,
                               stdin=subprocess.DEVNULL)
            if r.returncode == 0:
                got = json.loads(r.stdout)
                if isinstance(got, list):
                    return got
        except (OSError, ValueError):
            pass
        return None

    def export(self, n, session, cwd):
        """Save Crit's comments for round n under reviews/, never replacing a richer export.

        Asks the live session first, then the review Crit saved on disk. Returns the data kept."""
        data = self._comments(["comments", "--session", session, "--json", "--all"], cwd)
        if data is None:
            saved = os.path.join(crit_out_dir(self.ws), "reviews", session, "review.json")
            data = self._comments(["comments", "-o", crit_out_dir(self.ws), "--json", "--all", saved], cwd)
        if data is None:
            data = []
        self.fresh = data
        return self.save(n, data)

    def note_approval(self, n):
        name = f"{self.gate}-round{n}.approved.json"
        body = {"version": 1, "gate": self.gate, "round": n, "approved": True,
                "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "note": "Crit approved this round; every thread was resolved or deleted at approval, and the final "
                        "state could not be exported because Crit deletes the review on approval."}
        target = os.path.join(self.ws, "reviews", name)
        try:
            os.makedirs(os.path.dirname(target), exist_ok=True)
            tmp = target + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(body, f, indent=2)
                f.write("\n")
            os.replace(tmp, target)
        except OSError as e:
            warn(f"could not write reviews/{name}: {e}")

    def save(self, n, data):
        name = f"{self.gate}-round{n}.json"
        target = os.path.join(self.ws, "reviews", name)
        try:
            old = None
            if os.path.exists(target):
                with open(target) as f:
                    old = json.load(f)
            if isinstance(old, list) and comment_count(data) < comment_count(old):
                warn(f"kept reviews/{name} (the new export had fewer comments)")
                return old
            os.makedirs(os.path.join(self.ws, "reviews"), exist_ok=True)
            tmp = os.path.join(self.ws, "reviews", f".{name}.tmp")
            try:
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2, ensure_ascii=False)
                    f.write("\n")
                os.replace(tmp, target)
            except BaseException:
                try:
                    os.remove(tmp)
                except OSError:
                    pass
                raise
        except (OSError, ValueError) as e:
            warn(f"could not write reviews/{name}: {e}")
            self.failed = True
        return data


def cmd_gate_review(a):
    ws = gate_context(a.gate, "gate review")
    gate = a.gate
    files = artifact_paths(ws, a.files, "gate review") if a.files else []
    state = load_gate_state(ws, gate)
    pending = state.get("pending") if state else None
    if pending is not None and not (isinstance(pending, dict) and isinstance(pending.get("round"), int)
                                    and isinstance(pending.get("session"), str)):
        pending = None
    approved = bool(state and state.get("approved") is True)
    unfinished = bool(state and state.get("approved") is False and state.get("session"))
    if pending and not a.new:
        mode = "resume"
    elif not state or approved or a.new:
        mode = "new"
    else:
        mode = "continue"
    stored = list(state.get("files") or []) if state else []
    if mode in ("resume", "continue"):
        if files and set(files) != set(stored):
            die(f"gate review: the named files differ from the review's files ({', '.join(stored)}); "
                "use --new to start a fresh review")
        files = stored
    elif not files:
        die("gate review: name at least one file to review")
    require_crit(gate)

    last_used = max(state.get("round", 0) if state else 0, pending["round"] if pending else 0)
    run = GateRun(ws, gate)
    if mode == "resume":
        n = pending["round"]
    else:
        n = last_used + 1
    open_round = n if mode == "new" else int((state or {}).get("open_round") or 1)
    outgoing = None
    if mode == "resume" or pending:
        outgoing = (pending["round"], pending["session"])
    elif mode == "continue" or (a.new and unfinished):
        outgoing = (state["round"], state["session"])
    if outgoing:
        old_dir = os.path.join(crit_out_dir(ws), gate, f"r{int((state or {}).get('open_round') or 1)}")
        os.makedirs(old_dir, exist_ok=True)
        run.export(*outgoing, old_dir)
        carried = run.fresh if mode == "continue" else None

    # Crit keeps a continued review's comments, so a continued round starts from the outgoing round's.
    # (If Crit then deletes the review at approval before it can be read, this is what is left.)
    if outgoing and mode == "continue":
        run.save(n, carried)

    # Crit keys a session on its working directory and file arguments, so every review of a gate
    # runs from its own directory: re-running it continues or resumes the same session.
    o = crit_out_dir(ws)
    review_dir = os.path.join(o, gate, f"r{open_round}")
    os.makedirs(review_dir, exist_ok=True)
    argv = [crit_bin(), "-o", o] + (["--no-open"] if a.no_open else []) + [os.path.join(ws, f) for f in files]
    try:
        proc = subprocess.Popen(argv, cwd=review_dir, env=crit_env(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, start_new_session=True)
    except OSError as e:
        die(f"gate review: can't run Crit: {e}")

    try:
        interval = float(os.environ.get("TEAM_GATE_EXPORT_INTERVAL_SEC") or 60)
        if interval <= 0:
            interval = 60.0
    except ValueError:
        interval = 60.0
    sel = selectors.DefaultSelector()
    bufs = {}
    for stream, tag in ((proc.stdout, "out"), (proc.stderr, "err")):
        sel.register(stream, selectors.EVENT_READ, tag)
        bufs[tag] = bytearray()
    live_session, verdict, void, next_export, last_out = None, None, False, None, b"\n"

    def handle(tag, line):
        nonlocal live_session, verdict, void, state, next_export, last_out
        sink = sys.stdout.buffer if tag == "out" else sys.stderr.buffer
        try:
            sink.write(line)
            sink.flush()
        except (OSError, ValueError):
            pass
        text = line.decode("utf-8", errors="replace")
        if tag == "out":
            last_out = line[-1:]
            if "shut down before review was finished" in text:
                void = True
        elif text.strip() in ("approved: true", "approved: false"):
            verdict = text.strip() == "approved: true"
        elif live_session is None:
            m = SESSION_RE.search(text)
            if m:
                live_session = m.group(1)
                st = dict(state) if state else {"v": 1, "gate": gate, "session": None, "round": 0, "approved": None,
                                                "hashes": {}}
                st.update({"files": files, "open_round": open_round, "pending": {"round": n, "session": live_session}})
                save_gate_state(ws, gate, st)
                state = st
                run.export(n, live_session, review_dir)
                next_export = time.monotonic() + interval

    while sel.get_map():
        timeout = None if next_export is None else max(0.0, next_export - time.monotonic())
        ready = sel.select(timeout)
        for key, _ in ready:
            tag, buf = key.data, bufs[key.data]
            chunk = os.read(key.fileobj.fileno(), 65536)
            if not chunk:
                sel.unregister(key.fileobj)
                if buf:
                    handle(tag, bytes(buf))
                    buf.clear()
                continue
            buf += chunk
            while b"\n" in buf:
                i = buf.index(b"\n")
                line = bytes(buf[:i + 1])
                del buf[:i + 1]
                handle(tag, line)
        if not ready and next_export is not None and time.monotonic() >= next_export:
            run.export(n, live_session, review_dir)  # keeps the comments if Crit deletes the review on approval
            next_export = time.monotonic() + interval
    rc = proc.wait()
    use_session = live_session or (pending["session"] if mode == "resume" else None)
    kept = run.export(n, use_session, review_dir) if use_session else []
    if rc != 0 or verdict is None or void:
        why = (f"Crit exited with status {rc}" if rc != 0 else
               "the Crit daemon shut down before the review was finished" if void else "Crit printed no verdict")
        print(f"team-guard: gate {gate}: {why}; run `team-guard gate review {gate}` again to resume this round, "
              f"or `team-guard gate review {gate} <files> --new` to start a fresh review",
              file=sys.stderr)
        sys.exit(1)
    if verdict and not run.fresh and comment_count(kept) > 0:
        # Crit deleted the review at approval, so the final export is empty and the kept file is an
        # earlier copy. Say so beside it, and leave the export itself alone.
        run.note_approval(n)
    st = dict(state) if state else {"v": 1, "gate": gate}
    hashes = {}
    if verdict:
        for f in files:
            full = os.path.join(ws, f)
            if os.path.isfile(full):
                hashes[f] = sha256_file(full)
    st.update({"v": 1, "gate": gate, "files": files, "session": use_session, "round": n, "approved": verdict,
               "open_round": open_round, "hashes": hashes, "pending": None})
    save_gate_state(ws, gate, st)
    if last_out not in (b"\n", b""):
        sys.stdout.write("\n")
    print(f"gate {gate} round {n}: approved={'true' if verdict else 'false'} comments={0 if verdict else unresolved_count(kept)}")
    sys.stdout.flush()


def cmd_gate_reply(a):
    ws = gate_context(a.gate, "gate reply")
    label = "gate reply"
    if not a.author or not a.author.strip():
        die(f"{label}: --author is required")
    if not a.file:
        die(f"{label}: --file is required")
    path = os.path.realpath(os.path.abspath(a.file))
    try:
        with open(path, encoding="utf-8") as f:
            entries = json.load(f)
    except OSError:
        die(f"{label}: can't read {a.file}")
    except ValueError:
        die(f"{label}: {a.file} is not valid JSON")
    if not isinstance(entries, list):
        die(f"{label}: {a.file} must be a JSON array of replies")
    for i, e in enumerate(entries):
        if not isinstance(e, dict):
            die(f"{label}: entry {i} is not an object")
        if not isinstance(e.get("reply_to"), str):
            die(f"{label}: entry {i} needs a string reply_to")
        if not isinstance(e.get("body"), str) or not e["body"]:
            die(f"{label}: entry {i} needs a non-empty string body")
        if "resolve" in e and e["resolve"] is not False:
            die(f"{label}: entry {i}: replies never resolve a thread; resolve must be absent or false")
    state = load_gate_state(ws, a.gate)
    if state and state.get("pending"):
        die(f"{label}: gate {a.gate}: a review round is in progress; reply after the human finishes it")
    if not (state and state.get("approved") is False and state.get("session")):
        die(f"{label}: gate {a.gate} has no unfinished review")
    n, session = state.get("round"), state["session"]
    require_crit(a.gate, code=1)
    review_dir = os.path.join(crit_out_dir(ws), a.gate, f"r{int(state.get('open_round') or 1)}")
    os.makedirs(review_dir, exist_ok=True)
    run = GateRun(ws, a.gate)
    try:
        with open(path, "rb") as f:
            payload = f.read()
        r = subprocess.run([crit_bin(), "comment", "--session", session, "--json", "--author", a.author], cwd=review_dir,
                           env=crit_env(), input=payload)
        rc = r.returncode
    except OSError as e:
        print(f"team-guard: gate reply: can't run Crit: {e}", file=sys.stderr)
        rc = 1
    run.export(n, session, review_dir)
    if rc != 0:
        print(f"team-guard: gate {a.gate}: Crit could not take the replies (exit {rc}); replies need the review's "
              f"Crit session to be alive, so run `team-guard gate review {a.gate}` and then reply again",
              file=sys.stderr)
    sys.exit(0 if rc == 0 else 1)


def parse_gate_record(text):
    """[(name, date, [(hash, path)])] for every approval section with data, in file order."""
    sections, cur, fenced, done = [], None, False, False
    for line in text.split("\n"):
        if line.startswith("## "):
            m = GATE_HEADING.match(line)
            cur = [m.group("name"), m.group("date"), []] if m else None
            fenced, done = False, False
            if cur:
                sections.append(cur)
            continue
        if cur is None or done:
            continue
        if line.lstrip().startswith("```"):
            if fenced:
                done = True
            fenced = True
            continue
        if fenced:
            m = HASH_LINE.match(line)
            if m:
                cur[2].append((m.group(1), m.group(2)))
    return [(n, d, rows) for n, d, rows in sections if rows]


def read_gate_record(ws):
    try:
        with open(os.path.join(ws, GATE_RECORD), encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def append_gate_section(ws, gate, heading, rows):
    """Append one approval section, or report that the same approval is already recorded."""
    text = read_gate_record(ws)
    if text is not None:
        latest = [s for s in parse_gate_record(text) if s[0] == gate]
        if latest and set(latest[-1][2]) == set(rows):
            print(f"gate {gate}: already recorded")
            return
    fence = "`" * 3
    section = f"\n## {heading}\n\n{fence}\n" + "".join(f"{h}  {p}\n" for h, p in rows) + f"{fence}\n"
    path = os.path.join(ws, GATE_RECORD)
    with open(path, "ab") as f:
        if text is None:
            f.write(b"# Design gate record\n")
        elif text and not text.endswith("\n"):
            f.write(b"\n")
        f.write(section.encode("utf-8"))
    print(f"gate {gate}: recorded {len(rows)} file(s) in {GATE_RECORD}")


def cmd_gate_record(a):
    label = "gate record"
    ws = gate_context(a.gate, label)
    gate = a.gate
    today = time.strftime("%Y-%m-%d", time.gmtime())
    if a.crit:
        state = load_gate_state(ws, gate)
        if not state or state.get("approved") is not True:
            die(f"{label}: gate {gate}: the last review was not approved in Crit")
        if state.get("pending"):
            die(f"{label}: gate {gate}: a review round is in progress")
        stored = list(state.get("files") or [])
        if a.files and set(artifact_paths(ws, a.files, label)) != set(stored):
            die(f"{label}: gate {gate}: the named files differ from the reviewed files ({', '.join(stored)})")
        hashes = state.get("hashes") or {}
        bad = []
        for f in stored:
            full = os.path.join(ws, f)
            if not os.path.isfile(full):
                bad.append(f"missing: {f}")
            elif sha256_file(full) != hashes.get(f):
                bad.append(f"changed: {f}")
        if bad:
            print(f"team-guard: {label}: gate {gate}: reviewed files differ from the approval\n" + "\n".join(bad),
                  file=sys.stderr)
            sys.exit(1)
        rounds = state.get("round", 1) - state.get("open_round", 1) + 1
        rounds_text = "1 round" if rounds == 1 else f"{rounds} rounds"
        heading = f"{gate}: approved {today} in Crit ({rounds_text}, approved: true)"
        rows = [(hashes[f], f) for f in stored]
    else:
        if not a.files:
            die(f"{label}: name at least one file to record")
        files = artifact_paths(ws, a.files, label)
        literal = chat_literal(gate)
        if a.chat.strip() != literal:
            print(f'team-guard: gate {gate}: the reply that approves this gate is exactly "{literal}"', file=sys.stderr)
            sys.exit(1)
        heading = f"{gate}: approved {today} in chat (reply: {literal})"
        rows = [(sha256_file(os.path.join(ws, f)), f) for f in files]
    append_gate_section(ws, gate, heading, rows)


def cmd_gate_check(a):
    label = "gate check"
    ws = gate_context(a.gate, label)
    text = read_gate_record(ws)
    if text is None and a.gate:
        die(f"{label}: can't read {GATE_RECORD}")
    sections = parse_gate_record(text or "")
    if a.gate:
        sections = [s for s in sections if s[0] == a.gate]
    name = a.gate or (sections[-1][0] if sections else "-")
    if not sections:
        print(f"gate {name}: reopen the gate\nno approval recorded", file=sys.stderr)
        sys.exit(2)
    _, date, rows = sections[-1]
    bad = []
    for h, path in rows:
        full = os.path.join(ws, path)
        if not os.path.isfile(full):
            bad.append(f"missing: {path}")
        elif sha256_file(full) != h:
            bad.append(f"changed: {path}")
    if bad:
        print(f"gate {name}: reopen the gate\n" + "\n".join(bad), file=sys.stderr)
        sys.exit(2)
    print(f"gate {name}: matches the approval of {date}")


def cmd_gate(args):
    subs = ("review", "reply", "record", "check")
    if not args or args[0] not in subs:
        die("gate: expected review, reply, record or check")
    sub, rest = args[0], args[1:]
    label = "gate " + sub
    p = _Parser(prog="team-guard " + label, add_help=False)
    if sub == "check":
        p.add_argument("gate", nargs="?")
    else:
        p.add_argument("gate")
    if sub == "review":
        p.add_argument("files", nargs="*")
        p.add_argument("--new", action="store_true")
        p.add_argument("--no-open", action="store_true")
    elif sub == "reply":
        p.add_argument("--file")
        p.add_argument("--author")
    elif sub == "record":
        p.add_argument("files", nargs="*")
        g = p.add_mutually_exclusive_group(required=True)
        g.add_argument("--crit", action="store_true")
        g.add_argument("--chat")
    a = _parse_or_die(p, rest, label)
    {"review": cmd_gate_review, "reply": cmd_gate_reply, "record": cmd_gate_record, "check": cmd_gate_check}[sub](a)


def cmd_sign(args):
    p = _Parser(prog="team-guard sign", add_help=False)
    p.add_argument("--base")
    a = _parse_or_die(p, args, "sign")
    targets, _, _ = tool_targets(a.base, "sign")
    bad = []
    for name, top, base in targets:
        why = sign_problem(top, repo_ids(top)[1])
        if not why and git("rev-parse", "--verify", "--quiet", base + "^{commit}", cwd=top, check=False).returncode != 0:
            why = f"unknown base {base!r}"
        if why:
            bad.append(f"team-guard: sign: {name}: {why}")
    if bad:
        print("\n".join(bad), file=sys.stderr)
        sys.exit(1)
    for name, top, base in targets:
        hook, chained = hook_paths("pre-commit", top)
        state = hook_state("pre-commit", top)
        other = hook if state == "foreign" else chained if state == "installed" and os.path.exists(chained) else None
        if other:
            warn(f"{name}: another pre-commit hook runs on every amend ({other})")
    for name, top, base in targets:
        print(sign_repo(name, top, base))
        sys.stdout.flush()


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    commands = {
        "seal": lambda: cmd_seal(args), "unseal": lambda: cmd_unseal(args), "verify": cmd_verify,
        "list": cmd_list, "holdout-path": cmd_holdout_path,
        "hook-pretool": cmd_hook_pretool, "hook-task": cmd_hook_task, "hook-stop": cmd_hook_stop,
        "pre-commit": cmd_pre_commit, "git-hook": lambda: cmd_git_hook(args),
        "workspace": lambda: cmd_workspace(args), "workspace-path": lambda: cmd_workspace_path(args),
        "gc": lambda: cmd_gc(args), "pre-push": lambda: cmd_pre_push(args),
        "refs": lambda: cmd_refs(args), "routing": lambda: cmd_routing(args),
        "risk": lambda: cmd_risk(args), "sign": lambda: cmd_sign(args), "gate": lambda: cmd_gate(args),
    }
    if cmd not in commands or (cmd in ("seal", "unseal") and not args):
        sys.exit(__doc__)
    try:
        commands[cmd]()
    except WorkspaceFileError as e:
        workspace_file_die(e)
    except subprocess.CalledProcessError as e:
        die(f"git {' '.join(e.cmd[1:])} failed: {(e.stderr or '').strip()}")
    except OSError as e:
        label = f"workspace {args[0]}" if cmd == "workspace" and args else cmd
        die(f"{label}: {e}" + ("; fix the cause and rerun to resume" if label in ("workspace close", "gc") else ""))


if __name__ == "__main__":
    main()
