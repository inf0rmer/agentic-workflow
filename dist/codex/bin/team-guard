#!/usr/bin/env python3
"""Workspaces and commit signing for the agent-team workflow.

Workspaces (one per feature, under ~/.agentic-workflow/work/<feature>/):
  team-guard workspace new <feature> [--branch <name>]
  team-guard workspace attach <repo-path> [--base <branch>] [--feature <feature>]
  team-guard workspace list [--stale-days <N>]
  team-guard workspace show [<feature>]
  team-guard workspace close <feature> [--force]
  team-guard workspace-path     print the workspace dir containing the cwd

Signing:
  team-guard sign [--base <ref>]   re-sign the branch's commits with your own key before a push

Environment: TEAM_WORKSPACE_ROOT, TEAM_ARCHIVE_ROOT, TEAM_STALE_DAYS.
"""
import argparse
import calendar
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import time

POINTER_NAME = "team-workspace"
WS_FILE = "workspace.json"
# What an earlier version's git hooks carry, so sign can tell them from other hooks.
HOOK_MARKER = "# managed by team-guard"
CHAINED_SUFFIX = ".team-guard-chained"
FEATURE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
TS_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
DAY = 86400


# --- roots and small helpers ------------------------------------------------

def _root(var, default):
    return os.path.expanduser(os.environ.get(var) or default)


def ws_root():
    return os.path.realpath(_root("TEAM_WORKSPACE_ROOT", "~/.agentic-workflow/work"))


def archive_root():
    return os.path.realpath(_root("TEAM_ARCHIVE_ROOT", "~/.agentic-workflow/archive"))


def die(msg, code=1):
    print(f"team-guard: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"team-guard: warning: {msg}", file=sys.stderr)


def git(*args, cwd=None, check=True):
    return subprocess.run(["git", *args], cwd=cwd, check=check, capture_output=True, text=True, stdin=subprocess.DEVNULL)


def realpath(p):
    return os.path.realpath(p)


def under(path, root):
    path, root = realpath(path), realpath(root)
    if path == root:
        return True
    try:
        return os.path.commonpath([path, root]) == root
    except ValueError:
        return False


def nearest_existing_dir(p):
    p = os.path.abspath(p)
    while not os.path.exists(p):
        parent = os.path.dirname(p)
        if parent == p:
            break
        p = parent
    return p if os.path.isdir(p) else os.path.dirname(p)


def utc_now():
    return time.strftime(TS_FORMAT, time.gmtime())


def parse_ts(s):
    try:
        return calendar.timegm(time.strptime(s, TS_FORMAT))
    except (TypeError, ValueError):
        return None


def int_setting(value, env_var, default, option):
    """A command-line option beats its env var, which beats the default; all must be non-negative ints."""
    if value is not None:
        name, raw = option, value
    elif os.environ.get(env_var) not in (None, ""):
        name, raw = env_var, os.environ[env_var]
    else:
        return default
    try:
        n = int(str(raw).strip())
    except ValueError:
        die(f"invalid {name}: {raw!r} is not a non-negative integer")
    if n < 0:
        die(f"invalid {name}: {raw!r} is not a non-negative integer")
    return n


# --- locating repos and workspaces ------------------------------------------

def repo_ids(d):
    """(top, absolute git dir, absolute common git dir) for the repo containing directory d, or None."""
    r = git("rev-parse", "--show-toplevel", "--absolute-git-dir", "--git-common-dir", cwd=d, check=False)
    lines = r.stdout.split("\n")
    if r.returncode or len(lines) < 3:
        return None
    top, gd, common = lines[:3]
    return realpath(top), realpath(gd), realpath(os.path.join(d, common))


def read_first_line(path):
    try:
        with open(path) as f:
            return f.readline().strip() or None
    except OSError:
        return None


def location_workspace(p):
    """The workspace dir that path p is in by location, or None."""
    root = ws_root()
    p = realpath(p)
    if p == root or not under(p, root):
        return None
    feature = os.path.relpath(p, root).split(os.sep)[0]
    if feature.startswith(".") or not os.path.isdir(os.path.join(root, feature)):
        return None
    return os.path.join(root, feature)


def resolve_workspace(start):
    """("ok", dir) | ("dangling", pointer) | None for a cwd or target path."""
    d = nearest_existing_dir(start)
    ids = repo_ids(d)
    if ids and ids[1] != ids[2]:  # a linked worktree
        ptr = read_first_line(os.path.join(ids[1], POINTER_NAME))
        if ptr:
            return ("ok", ptr) if os.path.isfile(os.path.join(ptr, WS_FILE)) else ("dangling", ptr)
    loc = location_workspace(d)
    return ("ok", loc) if loc else None


def repo_for_path(p):
    """(top, git dir) of the repo containing path p, or None. Never reads workspace.json."""
    d = nearest_existing_dir(p)
    ids = repo_ids(d)
    if not ids:
        return None
    loc = location_workspace(d)
    if loc and not under(ids[0], loc):
        return None  # the workspace root happens to sit inside some other repo
    return ids[0], ids[1]


class WorkspaceFileError(Exception):
    def __init__(self, path):
        super().__init__(path)
        self.path = path


def load_workspace(wsdir):
    path = os.path.join(wsdir, WS_FILE)
    try:
        with open(path) as f:
            data = json.load(f)
        if not isinstance(data, dict) or not isinstance(data.get("repos"), list):
            raise ValueError("not a workspace")
    except (OSError, ValueError):
        raise WorkspaceFileError(path)
    return data


def workspace_file_die(e, code=1):
    die(f"can't read {e.path} (missing or not valid JSON)", code)


def write_json_atomic(path, data):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def save_workspace(wsdir, data):
    names = [r["name"] for r in data["repos"]]
    sources = [r["source"] for r in data["repos"]]
    assert len(set(names)) == len(names) and len(set(sources)) == len(sources), "duplicate repo entry"
    write_json_atomic(os.path.join(wsdir, WS_FILE), data)


NO_WORKSPACE = ("no workspace found; create one with `team-guard workspace new <feature>` "
                "or run this from a workspace dir or an attached worktree")


def current_workspace_or_die():
    """The workspace dir containing the cwd; exits otherwise."""
    ws = resolve_workspace(os.getcwd())
    if ws is None:
        die(NO_WORKSPACE)
    if ws[0] == "dangling":
        die(f"the workspace pointer here is dangling: {ws[1]} has no {WS_FILE}")
    return ws[1]


def named_workspace_or_die(feature):
    if not valid_feature(feature) or not os.path.isdir(os.path.join(ws_root(), feature)):
        die(f"no workspace named {feature}")
    return os.path.join(ws_root(), feature)


def valid_feature(name):
    return bool(name and FEATURE_RE.match(name) and ".." not in name and not name.endswith((".", ".lock")))


# --- git hooks (sign warns when another hook runs on every amend) ---

def hook_paths(name, cwd=None):
    hooks = git("rev-parse", "--git-path", "hooks", cwd=cwd).stdout.strip()
    hook = os.path.join(os.path.abspath(os.path.join(cwd or ".", hooks)), name)
    return hook, hook + CHAINED_SUFFIX


def hook_state(name="pre-commit", cwd=None):
    hook, _ = hook_paths(name, cwd)
    if not os.path.exists(hook):
        return "missing"
    with open(hook, errors="replace") as f:
        return "installed" if HOOK_MARKER in f.read() else "foreign"


# --- argument parsing -------------------------------------------------------

class UsageError(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise UsageError(message)


def parse_or_exit(parser, args):
    try:
        return parser.parse_args(args)
    except UsageError as e:
        print(f"team-guard: {parser.prog}: {e}", file=sys.stderr)
        sys.exit(1)


# --- workspace status -------------------------------------------------------

def repo_ok(path):
    return os.path.isdir(path) and git("rev-parse", "--git-dir", cwd=path, check=False).returncode == 0


def rev_parse(repo, ref):
    r = git("rev-parse", "--verify", "-q", ref, cwd=repo, check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def base_refs(source, base):
    refs = ["refs/heads/" + base]
    out = git("for-each-ref", "--format=%(refname)", "refs/remotes", cwd=source, check=False).stdout.split()
    refs += [r for r in out if r.endswith("/" + base) and not r.endswith("/HEAD")]
    return refs


def entry_merged(e):
    tip = rev_parse(e["source"], "refs/heads/" + e["branch"])
    if tip is None:
        return True
    if tip == e.get("start"):
        return False
    for ref in base_refs(e["source"], e["base"]):
        if git("merge-base", "--is-ancestor", tip, ref, cwd=e["source"], check=False).returncode == 0:
            return True
    return False


def activity_time(wsdir, data):
    newest = 0.0
    for dirpath, dirnames, filenames in os.walk(wsdir):
        if dirpath == wsdir and "repos" in dirnames:
            dirnames.remove("repos")
        for f in filenames:
            try:
                st = os.lstat(os.path.join(dirpath, f))
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                newest = max(newest, st.st_mtime)
    for e in data["repos"]:
        r = git("log", "-1", "--format=%ct", "refs/heads/" + e["branch"], cwd=e["source"], check=False)
        if r.returncode == 0 and r.stdout.strip().isdigit():
            newest = max(newest, float(r.stdout.strip()))
    return newest


def workspace_status(wsdir, data, stale_days):
    """(status, missing source paths)."""
    missing = [e["source"] for e in data["repos"] if not repo_ok(e["source"])]
    if missing:
        return "stale", missing
    if data["repos"] and all(entry_merged(e) for e in data["repos"]):
        return "merged", missing
    if time.time() - activity_time(wsdir, data) >= stale_days * DAY:
        return "stale", missing
    return "active", missing


def created_time(wsdir, data):
    t = parse_ts(data.get("created"))
    if t is not None:
        return t
    try:
        return os.path.getmtime(os.path.join(wsdir, WS_FILE))
    except OSError:
        return time.time()


def age_days(t):
    return max(0, int((time.time() - t) // DAY))


def dir_size(path):
    total = 0
    for dirpath, dirnames, filenames in os.walk(path):
        for n in filenames + dirnames:
            try:
                total += os.lstat(os.path.join(dirpath, n)).st_size
            except OSError:
                pass
    return total


def fmt_size(n):
    v, i = float(n), 0
    while v >= 1024 and i < 4:
        v /= 1024
        i += 1
    return f"{int(v)}B" if i == 0 else f"{v:.1f}{'BKMGT'[i]}"


def workspace_dirs():
    root = ws_root()
    if not os.path.isdir(root):
        return []
    return [(n, os.path.join(root, n)) for n in sorted(os.listdir(root))
            if not n.startswith(".") and os.path.isdir(os.path.join(root, n))]


# --- workspace commands -----------------------------------------------------

def cmd_ws_new(a):
    feature = a.feature
    if not valid_feature(feature):
        die(f"invalid feature name '{feature}'")
    branch = a.branch if a.branch is not None else f"feat/{feature}"
    if branch.startswith("-") or git("check-ref-format", "--branch", branch, check=False).returncode:
        die(f"invalid branch name '{branch}'")
    root = ws_root()
    wsdir = os.path.join(root, feature)
    if os.path.lexists(wsdir):
        die(f"workspace {feature} already exists at {wsdir}")
    os.makedirs(root, exist_ok=True)
    try:
        os.mkdir(wsdir)
        os.mkdir(os.path.join(wsdir, "repos"))
        write_json_atomic(os.path.join(wsdir, WS_FILE), {
            "version": 1, "feature": feature, "branch": branch, "created": utc_now(), "repos": []})
    except OSError as e:
        shutil.rmtree(wsdir, ignore_errors=True)
        die(f"can't create workspace {feature}: {e}")
    print(f"team-guard: created workspace {feature} at {wsdir}")
    try:
        n = 0
        stale_days = int_setting(None, "TEAM_STALE_DAYS", 30, "--stale-days")
        for name, d in workspace_dirs():
            if name == feature:
                continue
            if workspace_status(d, load_workspace(d), stale_days)[0] in ("merged", "stale"):
                n += 1
        if n:
            print(f"team-guard: hint: {n} stale workspace(s); run `team-guard workspace list` to review them", file=sys.stderr)
    except BaseException as e:  # the hint must never change the outcome
        if isinstance(e, KeyboardInterrupt):
            raise


def worktree_holders(source):
    """Map of refs/heads name -> worktree path for every worktree of the repo."""
    holders, path = {}, None
    for line in git("worktree", "list", "--porcelain", cwd=source, check=False).stdout.splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line.startswith("branch "):
            holders[line[len("branch "):]] = path
    return holders


def main_worktree(d):
    for line in git("worktree", "list", "--porcelain", cwd=d, check=False).stdout.splitlines():
        if line.startswith("worktree "):
            return realpath(line[len("worktree "):])
    return None


def cmd_ws_attach(a):
    if a.feature:
        wsdir = named_workspace_or_die(a.feature)
    else:
        wsdir = current_workspace_or_die()
    try:
        data = load_workspace(wsdir)
    except WorkspaceFileError as e:
        workspace_file_die(e)
    feature = os.path.basename(wsdir)
    if data.get("closing"):
        die(f"workspace {feature} is being closed")

    d = nearest_existing_dir(a.repo_path) if os.path.exists(a.repo_path) else None
    if d is None or git("rev-parse", "--git-dir", cwd=d, check=False).returncode:
        if d is not None and git("rev-parse", "--is-bare-repository", cwd=d, check=False).stdout.strip() == "true":
            die(f"{a.repo_path}: bare repositories are not supported")
        die(f"{a.repo_path} is not a git repository")
    if git("rev-parse", "--is-bare-repository", cwd=d, check=False).stdout.strip() == "true":
        die("bare repositories are not supported")
    source = main_worktree(d)
    if not source or not os.path.isdir(source):
        die(f"{a.repo_path} is not a git repository")
    name = os.path.basename(source)
    for e in data["repos"]:
        if e["source"] == source:
            die(f"{source} is already attached to {feature} at {e['worktree']}")
    for e in data["repos"]:
        if e["name"] == name:
            die(f"can't attach {source} as {name}: {e['source']} is already attached as {name}")
    wt = os.path.join(wsdir, "repos", name)
    if os.path.lexists(wt):
        die(f"can't attach {source} as {name}: {wt} already exists")

    branch = data["branch"]
    base = a.base
    if not base:
        head = git("symbolic-ref", "-q", "refs/remotes/origin/HEAD", cwd=source, check=False)
        target = head.stdout.strip()
        base = target[len("refs/remotes/origin/"):] if target.startswith("refs/remotes/origin/") else "main"
    start_ref = next((r for r in ("refs/heads/" + base, "refs/remotes/origin/" + base) if rev_parse(source, r)), None)
    if not start_ref:
        die(f"base branch {base} not found in {source}")
    existing = rev_parse(source, "refs/heads/" + branch)
    if existing:
        holder = worktree_holders(source).get("refs/heads/" + branch)
        if holder:
            die(f"branch {branch} is already checked out in {realpath(holder)}")
    start = existing or rev_parse(source, start_ref)

    undo = []
    try:
        os.makedirs(os.path.join(wsdir, "repos"), exist_ok=True)
        cmd = ["git", "-c", "core.hooksPath=/dev/null", "-C", source, "worktree", "add"]
        cmd += [wt, branch] if existing else ["--no-track", "-b", branch, wt, start_ref]
        if not existing:
            undo.append(lambda: subprocess.run(["git", "-C", source, "branch", "-D", branch],
                                               capture_output=True, stdin=subprocess.DEVNULL))
        undo.append(lambda: subprocess.run(["git", "-C", source, "worktree", "prune"],
                                           capture_output=True, stdin=subprocess.DEVNULL))
        undo.append(lambda: shutil.rmtree(wt, ignore_errors=True))
        undo.append(lambda: subprocess.run(["git", "-C", source, "worktree", "remove", "--force", wt],
                                           capture_output=True, stdin=subprocess.DEVNULL))
        r = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if r.returncode:
            raise RuntimeError("git worktree add failed: " + r.stderr.strip())
        git_dir = realpath(git("rev-parse", "--absolute-git-dir", cwd=wt).stdout.strip())
        pointer = os.path.join(git_dir, POINTER_NAME)
        with open(pointer + ".tmp", "w") as f:
            f.write(wsdir + "\n")
        os.replace(pointer + ".tmp", pointer)
        data["repos"].append({
            "name": name, "source": source, "worktree": realpath(wt), "branch": branch, "base": base,
            "start": start, "reused": bool(existing), "attached": utc_now(), "git_dir": git_dir})
        save_workspace(wsdir, data)
    except BaseException as e:
        # Undo in reverse order; the worktree comes off before the branch it holds.
        for fn in reversed(undo):
            try:
                fn()
            except Exception:
                pass
        if isinstance(e, KeyboardInterrupt):
            raise
        die(f"can't attach {source}: {e}")
    if existing:
        print(f"team-guard: reused existing branch {branch} at {existing[:12]}")
    print(f"team-guard: attached {name} at {realpath(wt)} on {branch} from {base}")


def cmd_ws_list(a):
    stale_days = int_setting(a.stale_days, "TEAM_STALE_DAYS", 30, "--stale-days")
    code = 0
    for feature, d in workspace_dirs():
        if empty_leftover(d):
            continue  # what an interrupted close leaves; `close` finishes it
        try:
            data = load_workspace(d)
        except WorkspaceFileError as e:
            print(f"{feature}\tinvalid\t-\t-")
            print(f"team-guard: can't read {e.path} (missing or not valid JSON)", file=sys.stderr)
            code = 1
            continue
        status, _ = workspace_status(d, data, stale_days)
        print(f"{feature}\t{status}\t{age_days(created_time(d, data))}d\t{fmt_size(dir_size(d))}")
    sys.stdout.flush()
    if code:
        sys.exit(code)


def cmd_ws_show(a):
    wsdir = named_workspace_or_die(a.feature) if a.feature else current_workspace_or_die()
    try:
        data = load_workspace(wsdir)
    except WorkspaceFileError as e:
        workspace_file_die(e)
    print(f"workspace: {wsdir}")
    print(f"feature: {data.get('feature', os.path.basename(wsdir))}")
    print(f"branch: {data.get('branch', '')}")
    for e in data["repos"]:
        print(f"repo {e['name']} source={e['source']} worktree={e['worktree']} base={e['base']}")


def move_into(src, dst):
    """Move src to dst; when both are directories, merge."""
    if os.path.isdir(src) and not os.path.islink(src) and os.path.isdir(dst):
        for n in os.listdir(src):
            move_into(os.path.join(src, n), os.path.join(dst, n))
        os.rmdir(src)
        return
    if os.path.lexists(dst):
        if os.path.isdir(dst) and not os.path.islink(dst):
            shutil.rmtree(dst)
        else:
            os.remove(dst)
    shutil.move(src, dst)


def registered_worktrees(src):
    """Realpaths of every worktree the source repo lists."""
    out = git("worktree", "list", "--porcelain", cwd=src, check=False).stdout.splitlines()
    return {realpath(l[len("worktree "):]) for l in out if l.startswith("worktree ")}


def owns_checkout(wt, entry):
    """True when wt/.git is a gitfile naming the git dir recorded at attach time."""
    try:
        with open(os.path.join(wt, ".git")) as f:
            line = f.readline().strip()
    except OSError:
        return False
    return line.startswith("gitdir:") and bool(entry.get("git_dir")) \
        and realpath(line[len("gitdir:"):].strip()) == realpath(entry["git_dir"])


def detached_orphan(wt):
    """The full sha of a detached HEAD that no local branch holds, else None.

    Remote-tracking refs don't count: they can be stale, and the commit is gone once the
    worktree is. A git error counts as an orphan, since a wrong guess here loses work.
    """
    code = git("symbolic-ref", "-q", "HEAD", cwd=wt, check=False).returncode
    if code == 0:
        return None
    r = git("rev-list", "-1", "HEAD", "--not", "--branches", cwd=wt, check=False)
    if code == 1 and r.returncode == 0 and not r.stdout.strip():
        return None
    head = git("rev-parse", "HEAD", cwd=wt, check=False)
    return head.stdout.strip() if head.returncode == 0 and head.stdout.strip() else "(unknown commit)"


def refusal_line(wt, reason):
    """How a refusal names a problem; a detached commit gets the command that keeps it."""
    m = re.fullmatch(r"detached HEAD ([0-9a-f]{40,64}) on no local branch", reason)
    if not (wt and m):
        return f"  {wt}: {reason}" if wt else f"  {reason}"
    sha, short = m.group(1), m.group(1)[:7]
    return (f"  {wt}: detached HEAD {short} is on no local branch; keep it with: "
            f"git -C {shlex.quote(wt)} branch keep-{short} {sha}")


def short_reason(reason):
    return re.sub(r"(detached HEAD [0-9a-f]{7})[0-9a-f]+", r"\1", reason)


class CloseRefused(Exception):
    def __init__(self, header, problems, force_hint):
        super().__init__(header)
        self.header, self.problems, self.force_hint = header, problems, force_hint


def close_workspace(feature, force=False, cwd=None):
    """Close a workspace: archive artifacts and remove worktrees. Raises CloseRefused; exits on failure."""
    wsdir = os.path.join(ws_root(), feature)
    try:
        data = load_workspace(wsdir)
    except WorkspaceFileError as e:
        workspace_file_die(e)
    recorded = [realpath(e["worktree"]) for e in data["repos"]]
    cwd = cwd if cwd is not None else safe_cwd()
    if cwd and (under(cwd, wsdir) or any(under(cwd, w) for w in recorded)):
        raise CloseRefused(f"can't close {feature} from inside it; run it from elsewhere", None, False)

    problems, discard = [], []
    repos_dir = os.path.join(wsdir, "repos")
    blocking = []
    real_repos = os.path.join(realpath(wsdir), "repos")
    expected = {n: os.path.join(real_repos, n) for n in (e["name"] for e in data["repos"])}
    if os.path.lexists(repos_dir):
        for n in sorted(os.listdir(repos_dir)):
            if n not in expected:
                blocking.append((None, f"unrecorded entry in repos/: {n}"))
    for e in data["repos"]:
        wt, src = e["worktree"], e["source"]
        if realpath(wt) != expected[e["name"]]:
            blocking.append((None, f"worktree outside workspace: {realpath(wt)}"))
            continue
        if os.path.isfile(os.path.join(wsdir, e["name"])):
            blocking.append((os.path.join(wsdir, e["name"]), "an artifact file has the name of an attached repo"))
        if not os.path.isdir(wt):
            continue
        if not repo_ok(src):
            if not owns_checkout(wt, e):
                blocking.append((None, f"worktree outside workspace: {realpath(wt)}"))
                continue
            problems.append((wt, "source repository missing"))
            continue
        if realpath(wt) not in registered_worktrees(src):
            blocking.append((None, f"worktree outside workspace: {realpath(wt)}"))
            continue
        if git("status", "--porcelain", cwd=wt, check=False).stdout.strip():
            problems.append((wt, "uncommitted changes"))
        refs = ["HEAD"]
        if rev_parse(src, "refs/heads/" + e["branch"]):
            refs.append("refs/heads/" + e["branch"])
        r = git("rev-list", "-1", *refs, "--not", "--remotes", cwd=wt, check=False)
        if r.returncode == 0 and r.stdout.strip():
            problems.append((wt, "unpushed commits"))
        orphan = detached_orphan(wt)
        if orphan:
            problems.append((wt, f"detached HEAD {orphan} on no local branch"))
    if blocking or (problems and not force):
        shown = blocking + ([] if force else problems)
        raise CloseRefused(f"can't close {feature}:", shown, bool(problems) and not force)
    discard = list(problems)

    closing = data.get("closing")
    if closing and closing.get("archive"):
        archive = closing["archive"]
    else:
        base = os.path.join(archive_root(), feature)
        archive, n = base, 1
        while os.path.lexists(archive):
            n += 1
            archive = f"{base}+{n}"
        closing = None
    os.makedirs(archive, exist_ok=True)
    if not closing:
        shutil.copy2(os.path.join(wsdir, WS_FILE), os.path.join(archive, WS_FILE))
        data["closing"] = {"archive": archive, "started": utc_now(), "forced": bool(force)}
        save_workspace(wsdir, data)

    reasons = {}
    for wt, reason in discard:
        reasons.setdefault(wt, []).append(reason)
    for e in list(data["repos"]):
        wt, src, name = e["worktree"], e["source"], e["name"]
        if os.path.isdir(wt) and not repo_ok(src):
            shutil.rmtree(wt)  # forced: nothing but the checkout is left to remove
            print(f"team-guard: removed worktree {wt}")
            for reason in reasons.get(wt, []):
                print(f"team-guard: discarded {short_reason(reason)} in {wt}")
        elif os.path.isdir(wt):
            for line in git("status", "--porcelain", "--ignored", cwd=wt, check=False).stdout.splitlines():
                if line.startswith("!! "):
                    print(f"team-guard: deleting ignored: {name}/{line[3:]}")
            r = subprocess.run(["git", "-C", src, "worktree", "remove", *(["--force"] if force else []), wt],
                               capture_output=True, text=True, stdin=subprocess.DEVNULL)
            if r.returncode:
                print(f"team-guard: git worktree remove failed for {wt}", file=sys.stderr)
                print(r.stderr.strip(), file=sys.stderr)
                sys.exit(1)
            print(f"team-guard: removed worktree {wt}")
            for reason in reasons.get(wt, []):
                extra = f" (branch {e['branch']} kept)" if reason == "unpushed commits" else ""
                print(f"team-guard: discarded {short_reason(reason)} in {wt}{extra}")
        elif repo_ok(src):
            git("worktree", "prune", cwd=src, check=False)
            print(f"team-guard: pruned missing worktree {wt}")
        else:
            warn(f"source repo {src} is missing; skipped {name}")
        data["repos"] = [x for x in data["repos"] if x["name"] != name]
        save_workspace(wsdir, data)

    for n in sorted(os.listdir(wsdir)):
        if n in ("repos", WS_FILE, WS_FILE + ".tmp"):
            continue
        move_into(os.path.join(wsdir, n), os.path.join(archive, n))
    meta = {"feature": feature, "closed": utc_now(), "workspace": wsdir, "forced": bool(force),
            "discarded": [{"worktree": wt, "reason": r} for wt, rs in reasons.items() for r in rs]}
    write_json_atomic(os.path.join(archive, "archive.json"), meta)
    # repos/ first, the workspace dir (which holds the `closing` marker) last, so a failure stays resumable.
    if os.path.lexists(repos_dir):
        os.rmdir(repos_dir)
    for n in (WS_FILE, WS_FILE + ".tmp"):
        if os.path.lexists(os.path.join(wsdir, n)):
            os.remove(os.path.join(wsdir, n))
    os.rmdir(wsdir)
    print(f"team-guard: closed {feature}; artifacts archived at {archive}")


def empty_leftover(wsdir):
    """True for an entirely empty, direct child of the workspace root: what an interrupted close leaves."""
    root = ws_root()
    return (os.path.isdir(wsdir) and not os.path.islink(wsdir) and os.path.dirname(realpath(wsdir)) == root
            and not os.path.basename(wsdir).startswith(".") and not os.listdir(wsdir))


def safe_cwd():
    try:
        return realpath(os.getcwd())
    except OSError:
        return None


def cmd_ws_close(a):
    wsdir = named_workspace_or_die(a.feature)
    if empty_leftover(wsdir):
        os.rmdir(wsdir)
        print(f"team-guard: closed {a.feature}; finished an interrupted close")
        return
    try:
        close_workspace(a.feature, a.force)
    except CloseRefused as e:
        if e.problems is None:
            die(e.header)
        lines = [f"team-guard: {e.header}"] + [refusal_line(p, why) for p, why in e.problems]
        if e.force_hint:
            detached = any("detached HEAD" in why for _, why in e.problems)
            lines.append("use --force to remove them anyway (branches are kept"
                         + ("; a detached commit on no branch is not)" if detached else ")"))
        print("\n".join(lines), file=sys.stderr)
        sys.exit(1)


def cmd_workspace(args):
    sub = args[0] if args else ""
    rest = args[1:]
    p = Parser(prog=f"workspace {sub}", add_help=False)
    if sub == "new":
        p.add_argument("feature")
        p.add_argument("--branch")
    elif sub == "attach":
        p.add_argument("repo_path")
        p.add_argument("--base")
        p.add_argument("--feature")
    elif sub == "list":
        p.add_argument("--stale-days", type=int)
    elif sub == "show":
        p.add_argument("feature", nargs="?")
    elif sub == "close":
        p.add_argument("feature")
        p.add_argument("--force", action="store_true")
    else:
        print("team-guard: workspace: expected new|attach|list|show|close\n" + __doc__, file=sys.stderr)
        sys.exit(1)
    a = parse_or_exit(p, rest)
    {"new": cmd_ws_new, "attach": cmd_ws_attach, "list": cmd_ws_list,
     "show": cmd_ws_show, "close": cmd_ws_close}[sub](a)


def cmd_workspace_path(args):
    parse_or_exit(Parser(prog="workspace-path", add_help=False), args)
    ws = resolve_workspace(os.getcwd())
    if ws is None:
        die("not inside a workspace")
    if ws[0] == "dangling":
        die(f"the workspace pointer here is dangling: {ws[1]} has no {WS_FILE}")
    if not os.path.isfile(os.path.join(ws[1], WS_FILE)):
        die(f"can't read {os.path.join(ws[1], WS_FILE)} (missing)")
    print(ws[1])


class _ArgError(Exception):
    pass


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        raise _ArgError(message)


def _parse_or_die(parser, args, label):
    try:
        return parser.parse_args(args)
    except _ArgError as e:
        die(f"{label}: {e}")


def tool_targets(base_arg, label):
    """([(name, top, base)], in_workspace, workspace dir) for the current workspace or repo; exits 1 otherwise."""
    ws = resolve_workspace(os.getcwd())
    if ws and ws[0] == "ok":
        out = []
        for e in load_workspace(ws[1])["repos"]:
            wt = e["worktree"]
            ids = repo_ids(wt) if os.path.isdir(wt) else None
            if not ids or ids[0] != realpath(wt):
                die(f"{label}: {e['name']}: repository unavailable: {wt}")
            out.append((e["name"], ids[0], base_arg or e["base"]))
        return out, True, ws[1]
    r = repo_for_path(os.getcwd())
    if not r:
        die("not a git repository")
    if not base_arg:
        die(f"{label}: --base is required outside a workspace")
    return [(os.path.basename(r[0]), r[0], base_arg)], False, None


# --- sign ---

def sign_problem(top, git_dir):
    """Why this repo can't be re-signed safely, or None."""
    if any(os.path.exists(os.path.join(git_dir, d)) for d in ("rebase-merge", "rebase-apply")):
        return "a rebase is in progress"
    if os.path.exists(os.path.join(git_dir, "MERGE_HEAD")):
        return "a merge is in progress"
    if git("symbolic-ref", "-q", "HEAD", cwd=top, check=False).returncode != 0:
        return "HEAD is detached"
    if git("status", "--porcelain", "--untracked-files=no", cwd=top).stdout.strip():
        return "has uncommitted changes to tracked files"
    return None


def sign_repo(name, top, base):
    """Re-sign base..HEAD in one repo. Returns the success message; exits 1 (branch restored) on failure."""
    def fail(why):
        die(f"sign: {name}: {why}")

    def restore(orig):
        if git("rev-parse", "HEAD", cwd=top).stdout.strip() != orig:
            git("reset", "--hard", "--quiet", orig, cwd=top, check=False)

    orig = git("rev-parse", "HEAD", cwd=top).stdout.strip()
    rng = f"{base}..HEAD"
    if git("rev-parse", "--verify", "--quiet", base + "^{commit}", cwd=top, check=False).returncode != 0:
        fail(f"unknown base {base!r}")
    commits = git("rev-list", rng, cwd=top).stdout.split()
    if not commits:
        return f"team-guard: sign: {name}: nothing to sign"
    trees0 = git("log", "--reverse", "--topo-order", "--format=%T", rng, cwd=top).stdout.split()
    r = git("rebase", "--keep-base", "--rebase-merges", "--empty=keep", "--exec",
            "git commit --amend --allow-empty --no-edit -S", base, cwd=top, check=False)
    if r.returncode != 0:
        git("rebase", "--abort", cwd=top, check=False)
        restore(orig)
        detail = " ".join((r.stderr or r.stdout).split())[-300:]
        fail(f"the signing rebase failed and the branch was restored ({detail})")
    def check():
        """Why the rewritten branch is not acceptable, or None. Any git failure here raises CalledProcessError."""
        now_commits = git("rev-list", rng, cwd=top).stdout.split()
        if any("\ngpgsig " not in git("cat-file", "commit", c, cwd=top).stdout for c in now_commits):
            return "some commits are still unsigned"
        if git("log", "--reverse", "--topo-order", "--format=%T", rng, cwd=top).stdout.split() != trees0 \
                or len(now_commits) != len(commits):
            return "the rewritten commits differ from the originals"
        if git("diff", "--quiet", orig, "HEAD", cwd=top, check=False).returncode != 0:
            return "the rewritten branch differs from the original in content"
        if verified:
            # A verifier that exits without reading the signed payload can make git die of SIGPIPE, so a
            # failed run of this check is a failed check rather than a clean result.
            marks = git("log", "--format=%G?", rng, cwd=top).stdout.split()
            if any(m not in ("G", "U") for m in marks):
                return "a signature did not verify"
        return None

    fmt = git("config", "--get", "gpg.format", cwd=top, check=False).stdout.strip()
    allowed = git("config", "--get", "gpg.ssh.allowedSignersFile", cwd=top, check=False).stdout.strip()
    verified = fmt in ("", "openpgp") or (fmt == "ssh" and bool(allowed))
    try:
        problem = check()
    except subprocess.CalledProcessError as e:
        why = " ".join((e.stderr or "").split())[-300:] or (
            f"git exited with signal {-e.returncode}" if e.returncode < 0 else f"git exited with status {e.returncode}")
        problem = f"could not check the rewritten branch (git {' '.join(e.cmd[1:3])}: {why})"
    if problem:
        restore(orig)
        fail(problem + "; the branch was restored")
    note = "; signatures present, not verified (set gpg.ssh.allowedSignersFile to verify them)" \
        if fmt == "ssh" and not allowed else ""
    return f"team-guard: sign: {name}: signed {len(commits)} commit(s){note}"


def cmd_sign(args):
    p = _Parser(prog="team-guard sign", add_help=False)
    p.add_argument("--base")
    a = _parse_or_die(p, args, "sign")
    targets, _, _ = tool_targets(a.base, "sign")
    bad = []
    for name, top, base in targets:
        why = sign_problem(top, repo_ids(top)[1])
        if not why and git("rev-parse", "--verify", "--quiet", base + "^{commit}", cwd=top, check=False).returncode != 0:
            why = f"unknown base {base!r}"
        if why:
            bad.append(f"team-guard: sign: {name}: {why}")
    if bad:
        print("\n".join(bad), file=sys.stderr)
        sys.exit(1)
    for name, top, base in targets:
        hook, chained = hook_paths("pre-commit", top)
        state = hook_state("pre-commit", top)
        other = hook if state == "foreign" else chained if state == "installed" and os.path.exists(chained) else None
        if other:
            warn(f"{name}: another pre-commit hook runs on every amend ({other})")
    for name, top, base in targets:
        print(sign_repo(name, top, base))
        sys.stdout.flush()


def drain_stdin(seconds=2.0):
    """Read and discard what a harness pipes to a hook, but never wait on a stdin that stays open."""
    import select
    deadline = time.time() + seconds
    try:
        fd = sys.stdin.fileno()
        while time.time() < deadline:
            ready, _, _ = select.select([fd], [], [], max(0.0, deadline - time.time()))
            if not ready or not os.read(fd, 65536):
                return
    except (OSError, ValueError):
        return


def cmd_old_hook(args):
    """Old git hooks and old harness hooks still call these commands. They do nothing, on purpose and for good:
    a harness blocks the action when a hook exits 2, and git refuses a commit when a hook fails, so a leftover
    entry must never fail. They print nothing and exit 0."""


def cmd_old_harness_hook(args):
    """The same, for the harness hooks, which are given a JSON event on stdin: read it and throw it away."""
    drain_stdin()


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    commands = {
        "workspace": cmd_workspace, "workspace-path": cmd_workspace_path, "sign": cmd_sign,
        "pre-commit": cmd_old_hook, "pre-push": cmd_old_hook, "git-hook": cmd_old_hook,
        "hook-pretool": cmd_old_harness_hook, "hook-stop": cmd_old_harness_hook, "hook-task": cmd_old_harness_hook,
    }
    if cmd not in commands:
        print(f"team-guard: unknown command {cmd!r}\n" + __doc__, file=sys.stderr)
        sys.exit(1)
    try:
        commands[cmd](args)
    except WorkspaceFileError as e:
        workspace_file_die(e)
    except subprocess.CalledProcessError as e:
        die(f"git {' '.join(e.cmd[1:])} failed: {(e.stderr or '').strip()}")
    except OSError as e:
        label = f"workspace {args[0]}" if cmd == "workspace" and args else cmd
        die(f"{label}: {e}" + ("; fix the cause and rerun to resume" if label == "workspace close" else ""))


if __name__ == "__main__":
    main()
